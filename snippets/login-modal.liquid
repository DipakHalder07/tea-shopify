<div class="details-modal" id="login-modal__window" role="dialog" aria-modal="true" aria-labelledby="customer--login">
  <div class="detial-login">
    <div class="details-modal-close" aria-label="{{ 'accessibility.close' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="2" y1="2" x2="14" y2="14"></line>
        <line x1="14" y1="2" x2="2" y2="14"></line>
      </svg>
    </div>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      <div class="heading-wrapper">
        <h1 id="customer--login" tabindex="-1">
          <span class="waving-emoji">&#128075;</span> Step into Style !
        </h1>
        <p>{{ 'customer.login_page.model_description' | t | default: 'Aliquam vestibulum mauris eu velit imperdiet venenatis. Clasent taciti sociosqu ad litora torquent per conubia nostra' }}</p>
      </div>

      {%- if form.errors -%}
        <h2 class="form__message" tabindex="-1" autofocus>
          <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
          <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13" width="13" height="13">
            <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
            <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
          </svg>
          {{ 'templates.contact.form.error_heading' | t }}
        </h2>
        {{ form.errors | default_errors }}
      {%- endif -%}

      <div class="field email field--with-error">       
        <input
          type="email"
          name="customer[email]"
          id="CustomerEmail"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'form' %}
            aria-invalid="true"
          {% endif %}
          placeholder="{{ 'customer.login_page.email' | t | default: 'Email' }}"
          required          
          onblur="emailValidation()" 
          onfocus="emailValidation()"      
          onkeypress="emailValidation()"
          oninput="emailValidation()"
        >        
      </div>

      {%- if form.password_needed -%}
        <div class="field pass field--with-error">       
          <input
            type="password"
            value=""
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="current-password"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.password' | t | default: 'Password' }}"
            required            
            onblur="passValidation()" 
            onfocus="passValidation()"      
            onkeypress="passValidation()"
            oninput="passValidation()"
          >
        </div>
      {%- endif -%}

      <div class="link-wrapper">
        <a href="{{ routes.account_login_url }}#recover" class="link-forgot">
          {{ 'customer.login_page.forgot_password' | t | default: 'Forgot your password?' }}
        </a>
        <a href="{{ routes.account_register_url }}" class="link-signup">
          {{ 'customer.login_page.create_account' | t | default: 'Sign Up' }}
        </a>
      </div>

      <button type="submit" class="button button--primary login-submit-btn">
        {{ 'customer.login_page.sign_in' | t | default: 'SIGN IN' }}
      </button>
    {%- endform -%}
  </div>
</div>

<script>
  function emailValidation() {    
    const emailID = document.getElementById('CustomerEmail');
    if (!emailID) return;
    const email = emailID.value;
    const pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;
    if (email.match(pattern)) {
      emailID.parentElement.classList.add('valid');
      emailID.parentElement.classList.remove('invalid');
    } else {
      emailID.parentElement.classList.remove('valid');
      emailID.parentElement.classList.add('invalid');
    }
  }

  function passValidation() {
    const passID = document.getElementById('CustomerPassword');
    if (!passID) return;
    const pass = passID.value;
    const passPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@.#$!%*?&])[A-Za-z\d@.#$!^%*?&]{6,15}$/;
    if (pass.match(passPattern)) {
      passID.parentElement.classList.add('valid');
      passID.parentElement.classList.remove('invalid');
    } else {
      passID.parentElement.classList.remove('valid');
      passID.parentElement.classList.add('invalid');
    }
  }

  function initLoginModal() {
    const modalWindow = document.getElementById('login-modal__window');
    if (!modalWindow) return;

    function openModal(e) {
      if (e) e.preventDefault();
      modalWindow.classList.add('login-modal-active');
      document.body.classList.add('overflow-hidden');
    }

    function closeModal(e) {
      if (e) e.preventDefault();
      modalWindow.classList.remove('login-modal-active');
      document.body.classList.remove('overflow-hidden');
    }

    // Attach to all login/account buttons across desktop and mobile
    const accountButtons = document.querySelectorAll(
      '.header__icon--account, [data-open-login-modal], a[href*="account/login"], .mobile-toolbar a[href*="login"], .mobile-toolbar a[href*="customer_authentication"]'
    );
    accountButtons.forEach(btn => {
      btn.addEventListener('click', openModal);
    });

    // Close button
    const closeBtn = modalWindow.querySelector('.details-modal-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Click outside modal card to close
    modalWindow.addEventListener('click', function (e) {
      if (e.target === modalWindow) {
        closeModal(e);
      }
    });

    // Escape key to close
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modalWindow.classList.contains('login-modal-active')) {
        closeModal(e);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoginModal);
  } else {
    initLoginModal();
  }
</script>

<style>
  /* ==========================================================================
     LOGIN MODAL STYLES & HIGH Z-INDEX (9999999)
     ========================================================================== */
  .details-modal {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
