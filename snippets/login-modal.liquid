    transition: background-color 0.25s ease, transform 0.15s ease, box-shadow 0.25s ease !important;
  }

  .detial-login button.button:hover,
  .detial-login button.button--primary:hover,
  .detial-login button.login-submit-btn:hover {
    background: #d6006e !important;
    background-color: #d6006e !important;
    color: #ffffff !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 14px rgba(255, 0, 133, 0.4) !important;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 750px) {
    .detial-login {
      padding: 36px 28px 40px !important;
      max-width: 90% !important;
    }
    .detial-login h1#customer--login {
      font-size: 28px !important;
    }
    .detial-login h1#customer--login .waving-emoji {
