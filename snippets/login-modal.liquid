  }

  .detial-login h1#customer--login .waving-emoji {
    font-size: 36px !important;
    display: inline-block !important;
  }

  .detial-login .heading-wrapper p {
    font-family: var(--font-body-family), "Inter Tight", "Poppins", sans-serif !important;
    font-size: 13.5px !important;
    line-height: 1.55 !important;
    color: rgba(16, 11, 6, 0.75) !important;
    max-width: 440px !important;
    margin: 0 auto !important;
    font-weight: 400 !important;
  }

  /* Form & Inputs */
  #customer_login {
    position: relative !important;
  }

  .detial-login .field {
    position: relative !important;
    margin-bottom: 16px !important;
    width: 100% !important;
  }

  .detial-login .field label {
    display: none !important;
  }

  .detial-login .field input {
    width: 100% !important;
    height: 52px !important;
    line-height: 52px !important;
    padding: 0 52px 0 24px !important;
    background: #ffffff !important;
    border: 1.5px solid #E2E8F0 !important;
