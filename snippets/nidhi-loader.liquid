{% comment %}
  Nidhi Tea Animated Circular Revealer Loader
  Replicated exactly from Nidhi Tea index.html
{% endcomment %}

<style>
  #loader {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    overflow: hidden;
    pointer-events: auto;
  }
  .pl-bg {
    position: absolute;
    inset: 0;
    background-color: var(--gold, #F7C665);
  }
  .pl-revealer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    clip-path: circle(0% at 50% 50%);
    -webkit-clip-path: circle(0% at 50% 50%);
    will-change: clip-path;
  }
  .pl-revealer.rev-gold {
    background-color: var(--gold, #F7C665);
  }
  .pl-revealer.rev-flame {
    background-color: var(--flame, #F15726);
  }
  .pl-revealer.rev-cherry {
    background-color: var(--cherry, #C4321C);
  }
  .pl-revealer.rev-background {
    background-color: var(--background, #100B06);
  }
  .pl-item {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 26vw;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%) scale(0);
    will-change: transform;
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 640px) {
    .pl-item {
      width: 18vw;
    }
  }
  @media (min-width: 1024px) {
    .pl-item {
      width: 13vw;
    }
  }
  .pl-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pl-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52vw;
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
    will-change: transform, opacity;
    pointer-events: none;
    z-index: 30;
  }
  @media (min-width: 768px) {
    .pl-logo {
      width: 26vw;
    }
  }
  .pl-logo img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }
</style>

<div id="loader">
  <div class="pl-bg"></div>
  <div class="pl-revealer rev-gold"></div>
  <div class="pl-revealer rev-flame"></div>
  <div class="pl-revealer rev-cherry"></div>
  <div class="pl-revealer rev-background pl-last"></div>

  <div class="pl-item">
    <img src="{{ 'isolated_cinnamon_sticks_star_anise_and_dried_orange_slices_for_tea_flavoring.png' | asset_url }}"
      alt="Tea Spices" />
  </div>
  <div class="pl-item">
    <img src="{{ 'honey.webp' | asset_url }}" alt="Honey Dipper" />
  </div>
  <div class="pl-item">
    <img src="{{ 'isolated_fresh_green_tea_leaves_with_water_droplets_macro_photography.png' | asset_url }}"
      alt="Fresh Tea Leaves" />
  </div>
  <div class="pl-item">
    <img src="{{ 'isolated_ceramic_bowl_of_dark_loose_leaf_oolong_tea_top_down_view_transparent.png' | asset_url }}"
      alt="Loose Leaf Tea" />
  </div>

  <div class="pl-logo">
    <img src="{{ 'logo.webp' | asset_url }}" alt="Nidhi Tea Logo" />
  </div>
</div>

<script>
  (function () {
    /* ---------- SPLIT TEXT PLUGIN ---------- */
    window.SplitTextPlugin = window.SplitTextPlugin || class {
      constructor(target, options = {}) {
        const elements = typeof target === "string" ? Array.from(document.querySelectorAll(target)) : (Array.isArray(target) ? target : [target]);
        this.chars = [];
        this.words = [];
        this.lines = [];

        elements.forEach((el) => {
          const wordsClass = options.wordsClass || "word";
          const charsClass = options.charsClass || "char";
          const includeChars = options.type && options.type.includes("chars");

          const processNode = (node, extraClasses = []) => {
            const fragment = document.createDocumentFragment();

            if (node.nodeType === 3) {
              const text = node.textContent;
              const wordsArr = text.split(/(\s+)/);

              wordsArr.forEach((part) => {
                if (/\s+/.test(part)) {
                  fragment.appendChild(document.createTextNode(part));
                  return;
                }
                if (!part) return;

                const wordSpan = document.createElement("span");
                wordSpan.className = [wordsClass, ...extraClasses].filter(Boolean).join(" ");
                wordSpan.style.display = "inline-block";

                if (includeChars) {
                  part.split("").forEach((char) => {
                    const charSpan = document.createElement("span");
                    charSpan.className = [charsClass, ...extraClasses].filter(Boolean).join(" ");
                    charSpan.style.display = "inline-block";
                    charSpan.textContent = char;
                    wordSpan.appendChild(charSpan);
                    this.chars.push(charSpan);
                  });
                } else {
                  wordSpan.textContent = part;
                }

                fragment.appendChild(wordSpan);
                this.words.push(wordSpan);
              });
            } else if (node.nodeType === 1) {
              if (node.tagName === "BR") {
                fragment.appendChild(node.cloneNode(true));
              } else {
                const elementClasses = Array.from(node.classList).filter(c => !["block", "flex", "grid", "hidden", "inline"].includes(c));
                const combinedClasses = [...extraClasses, ...elementClasses];
                Array.from(node.childNodes).forEach((child) => {
                  fragment.appendChild(processNode(child, combinedClasses));
                });
                if (node.classList.contains("block")) {
                  fragment.appendChild(document.createElement("br"));
                }
              }
            }

            return fragment;
          };

          const childNodes = Array.from(el.childNodes);
          el.innerHTML = "";
          childNodes.forEach((child) => {
            el.appendChild(processNode(child));
          });

          this.lines.push(el);
        });
      }

      static create(target, options) {
        return new window.SplitTextPlugin(target, options);
      }
    };

    function runNidhiLoader() {
      const el = document.getElementById("loader");
      if (!el) return;

      if (typeof gsap === "undefined") {
        el.style.display = "none";
        document.body.style.overflow = "";
        return;
      }

      document.body.style.overflow = "hidden";

      // Split heading if present
      let heading = null;
      const heroTitle = document.getElementById("heroTitle");
      if (heroTitle) {
        heading = window.SplitTextPlugin.create("#heroTitle", {
          type: "lines, words, chars",
          charsClass: "char",
          wordsClass: "word",
        });
        if (heading && heading.chars && heading.chars.length > 0) {
          gsap.set(heading.chars, { y: 55, opacity: 0, scale: 0.45 });
        }
      }

      const T = [
        { x: "-20vw", y: "-30vh", rotation: -20 },
        { x: "25vw", y: "-20vh", rotation: 15 },
        { x: "-32vw", y: "30vh", rotation: 12 },
        { x: "15vw", y: "25vh", rotation: -15 },
      ];
      const EXIT = 3.5, items = gsap.utils.toArray(".pl-item"), floats = [];
      const tl = gsap.timeline({
        delay: 0.2,
        onComplete: () => {
          el.remove();
          document.body.style.overflow = "";
          if (typeof ScrollTrigger !== "undefined") ScrollTrigger.refresh();
          window.dispatchEvent(new Event("loaderComplete"));
        }
      });

      // 1. Circle reveal stagger expansion
      tl.to(".pl-revealer", { clipPath: "circle(150% at 50% 50%)", duration: 0.9, stagger: 0.2, ease: "power2.inOut" });
      tl.set(".pl-revealer:not(.pl-last)", { display: "none" });

      // 2. Preloader items float to 4 corners over solid dark background
      items.forEach((item, i) => {
        const t = T[i], img = item.querySelector("img");
        tl.to(item, {
          x: t.x, y: t.y, scale: 1, rotation: t.rotation, duration: 0.9, ease: "power3.out",
          onStart: () => {
            floats[i] = gsap.to(img, { y: gsap.utils.random(-15, -25), duration: gsap.utils.random(1.5, 2.5), ease: "sine.inOut", yoyo: true, repeat: -1, delay: gsap.utils.random(0, 0.5) });
          }
        }, i === 0 ? "-=0.5" : "<0.075");
      });

      tl.to(".pl-logo", { scale: 1, opacity: 1, duration: 0.9, ease: "power3.out" }, "<");
      tl.set(".pl-bg", { display: "none" });
      tl.to({}, { duration: 0.5 });
      tl.add(() => floats.forEach(f => f && f.kill()));

      // 3. EXIT: Food items explode out, Logo shoots up, Loader background fades to opacity 0
      items.forEach((item, i) => {
        const t = T[i];
        tl.to(item, { x: parseFloat(t.x) * EXIT + "vw", y: parseFloat(t.y) * EXIT + "vh", rotation: t.rotation * 2.5, scale: 2.5, duration: 0.75, ease: "power2.in" }, i === 0 ? ">" : "<0.075");
      });
      tl.to(".pl-logo", { y: "-120vh", scale: 2.5, duration: 0.75, ease: "power2.in" }, "<");

      // Fade loader background smoothly from 1 to 0 at exit
      tl.to("#loader", { autoAlpha: 0, duration: 0.5, ease: "power2.out" }, "<0.1");

      // Hero heading chars pop into view with bouncy elastic animation right as loader fades
      if (heading && heading.chars && heading.chars.length > 0) {
        tl.to(
          heading.chars,
          {
            y: 0,
            opacity: 1,
            scale: 1,
            duration: 1.3,
            stagger: 0.015,
            ease: "elastic.out(0.75, 0.25)",
          },
          "<0.05"
        );
      }

      // Hero subtitle, badge, and navigation buttons staggered entrance
      tl.fromTo(
        "#heroSubtitle",
        { y: 30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.9, ease: "power3.out" },
        "-=0.8"
      );
      tl.fromTo(
        ["#heroName", "#heroNo"],
        { y: 25, opacity: 0 },
        { y: 0, opacity: 1, stagger: 0.1, duration: 0.8, ease: "power3.out" },
        "<0.1"
      );
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runNidhiLoader);
    } else {
      runNidhiLoader();
    }
  })();
</script>
