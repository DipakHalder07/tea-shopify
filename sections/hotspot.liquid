/*sample-marquee*/
.hotspot-block-section.sample-marquee a.dt-sc-hotspot-marker.dt-sc-hotspot-icon.style-4{border:1px solid var(--gradient-base-background-2); border-radius:50%;}
 .hotspot-block-section.sample-marquee a.dt-sc-hotspot-marker.dt-sc-hotspot-icon.style-4 div{width:13px; height:13px; background:var(--gradient-base-background-2); left: 0; right: 0; margin: auto; top: 0; bottom: 0; position:absolute; display:flex; align-items:center; justify-content:center; border-radius: 50%;}
.sample-marquee .row{position:relative; z-index:-1;} 
.hotspot-block-section.sample-marquee  .dt-sc-hotspot img.dt-sc-hotspot-image{border-radius:22px; }  
.hotspot-block-section.sample-marquee  .dt-sc-hotspot{z-index:-3;} 
.sample-marquee .image-text__marque { position: absolute; display: flex; overflow: hidden; color: #fff; z-index: 1;  transition: .5s ease;  background: var(--gradient-base-background-3); padding: 10px; border-radius: 22px;}
.sample-marquee .dt-sc-hotspot.numbered.style-2 { position: relative; width: 100%; height: 100%; display: block; background: var(--image-bg); border-radius: var(--image-radius); overflow: hidden;}
 .sample-marquee .marquee-top { left: 0; right: 0; top: 0; width: 100%; max-width: calc(100% - 60px); margin: 0 auto;}
.sample-marquee .marquee-bottom { left: 0; right: 0; bottom: 0; width: 100%; max-width: calc(100% - 60px); margin: 0 auto;}
.sample-marquee .marquee-left { left: 0; top: 0; height: 100%; writing-mode: vertical-rl;}
.sample-marquee .marquee-right { right: 0; top: 0; height: 100%; writing-mode: vertical-lr;}
.sample-marquee .image-text__marque-node { display: flex; white-space: nowrap; font-size: 3rem; font-weight: 700; line-height: 40px; font-family: var(--font-heading-family); font-style: normal;}
.sample-marquee .marquee-top .image-text__marque-node {
    padding: 5px 30px;
    animation: img-text-marque 10s linear infinite;
}
.sample-marquee .marquee-bottom .image-text__marque-node {
    padding: 5px 30px;
    animation: img-text-marque-bottom 10s linear infinite;
}
.sample-marquee .marquee-left .image-text__marque-node {
    padding: 30px 5px;
    animation: img-text-marque-horizontal 10s linear infinite;
}
.sample-marquee .marquee-right .image-text__marque-node {
    padding: 30px 5px;
    animation: img-text-marque-vertical 10s linear infinite;
}
  
@keyframes img-text-marque {
    0% {
        transform: translate(0);
        visibility: visible;
    }
    100% {
        transform: translate(-100%);
    }
}
@keyframes img-text-marque-bottom {
    0% {
        transform: translate(-100%);
        visibility: visible;
    }
    100% {
        transform: translate(0);
    }
}
@keyframes img-text-marque-vertical {
    0% {
        transform: translateY(0);
        visibility: visible;
    }
    100% {
        transform: translateY(-100%);
    }
}
@keyframes img-text-marque-horizontal {
    0% {
        transform: translateY(-100%);
        visibility: visible;
    }
    100% {
        transform: translateY(0);
    }
}
@media (max-width: 1200px) {
   .sample-marquee .image-text__marque-node {font-size:2rem; line-height:normal;}
}
 @media (max-width: 780px) {
   .sample-marquee .image-text__marque-node {font-size:1.6rem; line-height:normal;}
   .sample-marquee .marquee-top .image-text__marque-node { padding: 5px 15px;}
   .sample-marquee .marquee-bottom .image-text__marque-node { padding: 5px 15px;}
   .sample-marquee .marquee-left .image-text__marque-node {  padding: 15px 5px;}
   .sample-marquee .marquee-right .image-text__marque-node {  padding: 15px 5px;}
 }
 @media (max-width: 480px) {
   .sample-marquee .image-text__marque-node {font-size:1.4rem; line-height:normal;}
   .sample-marquee .marquee-top .image-text__marque-node { padding: 5px 5px;}
   .sample-marquee .marquee-bottom .image-text__marque-node { padding: 5px 5px;}
   .sample-marquee .marquee-left .image-text__marque-node {  padding: 5px 5px;}
   .sample-marquee .marquee-right .image-text__marque-node {  padding: 5px 5px;}
   .sample-marquee .image-text__marque{padding:0; border-radius:0;}
 }  
  {%- endstyle -%}  

