              sizes="100vw"
              src="{{ section.settings.spot_image | image_url: width: 1500 }}"
              loading="lazy"
              class="dt-sc-hotspot-image"
              alt="{{ section.settings.spot_image.alt | escape }}"
              width="{{ section.settings.spot_image.width }}"
              height="{{ section.settings.spot_image.height }}"
