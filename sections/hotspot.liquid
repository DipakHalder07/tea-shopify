{%- liquid
    case section.settings.icon_format  
    when 'numbered'
    assign icon_format = 'numbered'
    when 'alphabets'
    assign icon_format = 'alphabets'
    when 'simple-round' 
    assign icon_format = 'simple-round'
    when 'icon'
    assign icon_format = 'icon'
    endcase
-%}

{{ 'section-hotspot.css' | asset_url | stylesheet_tag }}
