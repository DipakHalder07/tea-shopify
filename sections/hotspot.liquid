.marquee-bottom {bottom: 8px;}
.marquee-top {top:5px}  
.hotspot-block-section.marquee-with-hotspot .dt-sc-hotspot{padding:20px;}   
.hotspot-block-section.marquee-with-hotspot .banner-text div { padding: 0 10px;} 
.hotspot-block-section .dt-sc-hotspot-item, .hotspot-block-section .dt-sc-hotspot-marker div{width:26px; height:26px; line-height: 26px;}   
.hotspot-block-section.marquee-with-hotspot a.dt-sc-hotspot-marker.dt-sc-hotspot-icon.style-4 div{    width: 7px; height: 7px;} 
