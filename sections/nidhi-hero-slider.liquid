{% comment %}
  Nidhi Tea Hero Slider Section
  Faithfully ports the Hero design and interactive carousel from Nidhi Tea index.html
  - Massive title: "Sip Wellness. Taste Purity. Love Every Cup."
  - High-contrast 2px dotted rule lines across the page
  - Prominent vibrant pulsing circular background with floating breathing animation
  - Floating product pack with idle 3D tilt & vertical float
  - Smooth blend switching with shrink & bloom animations
{% endcomment %}

<section id="hero" class="nidhi-hero-section">
  <!-- Corner Botanical Tea Branches (Decorative Background) -->
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-tl" />
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-br" />

  <!-- Hero Main Heading (3 Distinct Dramatic Lines) -->
  <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
    <div class="row">
      <div class="nidhi-heading-wrap">
        <h1 id="heroTitle" class="nidhi-hero-title">
          <span class="text-outline block">{{ section.settings.heading_line_1 | default: section.settings.heading_outline | default: 'Sip Wellness.' }}</span>
          <span class="text-cream block">{{ section.settings.heading_line_2 | default: 'Taste Purity.' }}</span>
          <span class="text-cream block">{{ section.settings.heading_line_3 | default: 'Love Every Cup.' }}</span>
        </h1>
      </div>
    </div>
  </div>

  <!-- Blend Indicator Rule Bar -->
  <div class="nidhi-blend-bar">
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>
    <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
      <div class="row">
        <div class="nidhi-blend-bar-inner">
          <span id="heroNo">Blend N0.01</span>
          <span id="heroName" class="animate-fade-in">Classic Masala Chai</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ HERO CAROUSEL ROW WITH FULL-WIDTH DOTTED LINE ============ -->
  <div class="nidhi-carousel-row">
    <!-- Edge-to-Edge Full-Width Horizontal Dotted Line Behind Slider & Navigation Buttons -->
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>

    <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
      <div class="row">
        <div class="nidhi-carousel-inner">
          <!-- Previous Slide Button -->
          <button data-hero="-1" type="button" aria-label="Previous blend" class="nidhi-nav-btn">
            <span>&larr;</span>
          </button>

          <!-- Center Active Blend Presentation Stage -->
          <div class="nidhi-stage">
            <!-- Wrapper for transition & parallax -->
            <div id="heroTintWrap"
              class="absolute flex items-center justify-center pointer-events-none transition-transform duration-500 will-change-transform"
              style="transform: scale(1);">
              
              <!-- The Animated Pulsating Background Circle -->
              <div id="heroTint"
                class="h-64 w-64 rounded-full transition-colors duration-700 sm:h-80 sm:w-80 md:h-[460px] md:w-[460px] lg:h-[540px] lg:w-[540px] xl:h-[620px] xl:w-[620px] animate-hero-bg"
                style="background: var(--pink)">
              </div>

            </div>

            <!-- Top-Left Floating Botanical Companion (Behind Product Pack: z-index 15) -->
            <div class="nidhi-companion-container nidhi-companion-container--behind">
              <div id="heroTopWrap" style="transform: scale(1);">
                <div class="animate-float-companion-top" style="pointer-events: none; display: flex; align-items: center; justify-content: center;">
                  <img id="heroTopImg"
                    src="{{ 'crisp_isolated_studio_macro_photography_of_exactly_one_single_ceylon_cinnamon-removebg-preview.png' | asset_url }}"
                    alt="Cinnamon"
                    class="nidhi-companion-img nidhi-companion-img--top" />
                </div>
              </div>
            </div>

            <!-- Dynamic Product Slide Packs (Midground: z-index 25) -->
            <div id="heroSlides"></div>

            <!-- Bottom-Right Floating Botanical Companion (In Front / Closer: z-index 30) -->
            <div class="nidhi-companion-container nidhi-companion-container--front">
              <div id="heroBottomWrap" style="transform: scale(1);">
                <div class="animate-float-companion-bottom" style="pointer-events: none; display: flex; align-items: center; justify-content: center;">
                  <img id="heroBottomImg"
                    src="{{ 'ginger.webp' | asset_url }}"
                    alt="Ginger"
                    class="nidhi-companion-img nidhi-companion-img--bottom" />
                </div>
              </div>
            </div>
          </div>

          <!-- Next Slide Button -->
          <button data-hero="1" type="button" aria-label="Next blend" class="nidhi-nav-btn">
            <span>&rarr;</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA Row With Dotted Line -->
  <div class="nidhi-cta-row">
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>
    <div class="nidhi-cta-pill-box">
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url | default: '/collections/all' }}" class="button button--primary">
        {{ section.settings.button_text | default: 'Explore Blends' }}
      </a>
    </div>
  </div>
</section>

<style>
  .nidhi-hero-section {
    position: relative;
    overflow: hidden;
    padding-top: 30px;
    padding-bottom: 35px;
    background-color: var(--background, #100B06);
    color: var(--cream, #f5e4c7);
  }
  @media (min-width: 768px) {
    .nidhi-hero-section {
      padding-top: 45px;
      padding-bottom: 45px;
    }
  }

  .nidhi-branch-tl {
    position: absolute;
    top: -4rem;
    left: -5rem;
    width: 320px;
    height: auto;
    opacity: 0.14;
    transform: rotate(-45deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .nidhi-branch-br {
    position: absolute;
    bottom: -5rem;
    right: -6rem;
    width: 340px;
    height: auto;
    opacity: 0.14;
    transform: rotate(135deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  @media (min-width: 640px) {
    .nidhi-branch-tl { width: 560px; opacity: 0.16; }
    .nidhi-branch-br { width: 600px; opacity: 0.16; }
  }
  @media (min-width: 1024px) {
    .nidhi-branch-tl { width: 800px; }
    .nidhi-branch-br { width: 850px; }
  }

  /* Container inner elements aligned with Shopify header container */
  .nidhi-heading-wrap {
    position: relative;
    z-index: 10;
    max-width: 1650px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    text-align: center;
  }
  @media (max-width: 767px) {
    .nidhi-heading-wrap {
      padding: 0 12px;
    }
  }
  .nidhi-hero-title {
    font-family: var(--font-display-family), "Fraunces", Georgia, serif !important;
    font-optical-sizing: auto;
    text-transform: uppercase;
    line-height: 0.86 !important;
    letter-spacing: -0.025em;
    font-weight: 800 !important;
    font-size: clamp(3.2rem, 11vw, 5.5rem) !important;
    margin: 0 auto;
    max-width: 1650px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .nidhi-hero-title {
      font-size: clamp(5.5rem, 9.8vw, 8.8rem) !important;
      line-height: 0.85 !important;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-hero-title {
      font-size: clamp(7.5rem, 9.6vw, 11.2rem) !important;
      line-height: 0.84 !important;
    }
  }
  .nidhi-hero-title .text-outline {
    color: transparent !important;
    -webkit-text-stroke: 2.5px #f5e4c7 !important;
  }
  @media (min-width: 1024px) {
    .nidhi-hero-title .text-outline {
      -webkit-text-stroke: 3px #f5e4c7 !important;
    }
  }
  .nidhi-hero-title .text-cream {
    color: #f5e4c7 !important;
  }

  #heroTitle .char,
  #heroTitle .word {
    display: inline-block;
    will-change: transform, opacity;
  }

  /* Dotted Rule Styling - Explicit display: block to override theme div:empty { display: none } */
  .dotted-rule,
  div.dotted-rule,
  div.dotted-rule:empty,
  .dotted-rule:empty {
    display: block !important;
    height: 1px !important;
    width: 100% !important;
    background-image: repeating-linear-gradient(
      to right,
      rgba(245, 228, 199, 0.45) 0px,
      rgba(245, 228, 199, 0.45) 4px,
      transparent 4px,
      transparent 10px
    ) !important;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    line-height: 0;
    font-size: 0;
  }

  /* Animation Name: bucks-fade */
  @keyframes bucks-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: bucks-fade 0.5s ease-out both;
  }

  #heroNo {
    background-color: var(--background, #100B06);
    padding-right: 1.25rem;
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  #heroName {
    background-color: var(--background, #100B06);
    padding-left: 1.25rem;
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  @media (max-width: 767px) {
    #heroNo {
      display: none !important;
    }
    .nidhi-blend-bar-inner {
      justify-content: center !important;
      text-align: center !important;
      padding: 0 10px;
    }
    #heroName {
      padding-left: 1.25rem !important;
      padding-right: 1.25rem !important;
      text-align: center !important;
      margin: 0 auto !important;
    }
  }

  .nidhi-cta-pill-box {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    background-color: var(--background, #100B06);
    padding: 0 1.25rem;
  }

  .nidhi-blend-bar {
    position: relative;
    z-index: 10;
    margin: 1.8rem 0 1rem 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar {
      margin: 2.2rem 0 1.2rem 0;
    }
  }
  .nidhi-blend-bar-inner {
    position: relative;
    z-index: 2;
    max-width: var(--large_desktop, 1500px);
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display-family), "Fraunces", Georgia, serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7;
    font-weight: 700;
  }
  @media (max-width: 767px) {
    .nidhi-blend-bar-inner {
      padding: 0 10px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar-inner {
      font-size: 16px;
    }
  }

  .nidhi-carousel-row {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0.8rem 0 1.2rem 0;
  }
  @media (min-width: 768px) {
    .nidhi-carousel-row {
      margin: 1.2rem 0 1.8rem 0;
    }
  }
  .nidhi-carousel-inner {
    position: relative;
    z-index: 10;
    max-width: var(--large_desktop, 1500px);
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  @media (max-width: 767px) {
    .nidhi-carousel-inner {
      padding: 0 10px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-carousel-inner {
      gap: 24px;
    }
  }

  .nidhi-nav-btn {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 2px solid #FF3366 !important;
    background-color: #FF3366 !important;
    color: #f5e4c7 !important;
    box-shadow: 0 10px 25px -5px rgba(255, 51, 102, 0.45);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    touch-action: manipulation;
  }
  @media (min-width: 640px) {
    .nidhi-nav-btn {
      width: 60px;
      height: 60px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-nav-btn {
      width: 72px;
      height: 72px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-nav-btn {
      width: 82px;
      height: 82px;
    }
  }
  .nidhi-nav-btn:hover {
    transform: scale(1.1);
    background-color: #E63946 !important;
    border-color: #E63946 !important;
    box-shadow: none !important;
    -webkit-box-shadow: none !important;
  }
  .nidhi-nav-btn span {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .nidhi-nav-btn span {
      font-size: 1.7rem;
    }
  }

  .nidhi-stage {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 56vh;
    min-height: 480px;
    max-height: 760px;
    overflow: visible;
  }
  @media (min-width: 640px) {
    .nidhi-stage {
      height: 62vh;
      min-height: 540px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-stage {
      height: 68vh;
      min-height: 600px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-stage {
      height: 74vh;
      min-height: 660px;
      max-height: 840px;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-stage {
      height: 78vh;
      min-height: 720px;
      max-height: 900px;
    }
  }

  /* Center Color Tint Circle (Sized Generously with Rhythmic Breathing Pulse & Ambient Glow) */
  #heroTintWrap {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition-property: transform;
    transition-duration: 500ms;
    will-change: transform;
    z-index: 5;
  }
  #heroTint {
    width: 17rem;
    height: 17rem;
    border-radius: 9999px;
    background: var(--pink, #FF3366);
    flex-shrink: 0;
    transition: background-color 700ms ease, background 700ms ease;
    box-shadow: none !important;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroTint {
      width: 22rem;
      height: 22rem;
    }
  }
  @media (min-width: 768px) {
    #heroTint {
      width: 460px;
      height: 460px;
    }
  }
  @media (min-width: 1024px) {
    #heroTint {
      width: 540px;
      height: 540px;
    }
  }
  @media (min-width: 1280px) {
    #heroTint {
      width: 620px;
      height: 620px;
    }
  }

  /* Animation Name: hero-bg-pulse */
  @keyframes hero-bg-pulse {
    0%, 100% {
      transform: scale(0.96);
    }
    50% {
      transform: scale(1.04);
    }
  }

  /* Class applied to the background circle */
  .animate-hero-bg {
    animation: hero-bg-pulse 6s ease-in-out infinite !important;
    will-change: transform;
  }

  /* Floating Idle Animation on Product Pack (Tilt 5deg + Float) */
  @keyframes hero-pack-float {
    0%, 100% {
      transform: rotate(4deg) translateY(0px);
    }
    50% {
      transform: rotate(6.5deg) translateY(-20px);
    }
  }
  .hero-floating-pack {
    animation: hero-pack-float 4.5s ease-in-out infinite !important;
    will-change: transform;
    transform-origin: center center;
  }

  /* Companion containers: sized closer to product pack */
  .nidhi-companion-container {
    position: absolute;
    inset: 0;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 320px;
    pointer-events: none;
  }
  @media (min-width: 640px) { .nidhi-companion-container { max-width: 420px; } }
  @media (min-width: 768px) { .nidhi-companion-container { max-width: 500px; } }
  @media (min-width: 1024px) { .nidhi-companion-container { max-width: 580px; } }
  @media (min-width: 1280px) { .nidhi-companion-container { max-width: 660px; } }

  .nidhi-companion-container--behind {
    z-index: 15;
  }
  .nidhi-companion-container--front {
    z-index: 30;
  }

  /* 1 Top-Left Corner Behind Product Pack */
  #heroTopWrap {
    position: absolute;
    top: 4%;
    left: 2%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroTopWrap {
      top: 6%;
      left: 3%;
    }
  }
  @media (min-width: 1024px) {
    #heroTopWrap {
      top: 7%;
      left: 4%;
    }
  }

  /* 1 Bottom-Right Corner In Front / Closer to Product Pack */
  #heroBottomWrap {
    position: absolute;
    bottom: 4%;
    right: 2%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroBottomWrap {
      bottom: 6%;
      right: 3%;
    }
  }
  @media (min-width: 1024px) {
    #heroBottomWrap {
      bottom: 7%;
      right: 4%;
    }
  }

  /* Floating Keyframes for Companions */
  @keyframes companion-float-tl {
    0%, 100% {
      transform: translateY(0px) rotate(-3deg);
    }
    50% {
      transform: translateY(-10px) rotate(3deg);
    }
  }
  .animate-float-companion-top {
    animation: companion-float-tl 5s ease-in-out infinite;
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  @keyframes companion-float-br {
    0%, 100% {
      transform: translateY(0px) rotate(3deg);
    }
    50% {
      transform: translateY(10px) rotate(-3deg);
    }
  }
  .animate-float-companion-bottom {
    animation: companion-float-br 4.6s ease-in-out infinite 0.7s;
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .nidhi-companion-img {
    position: relative;
    width: 90px;
    height: 90px;
    object-fit: contain;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .nidhi-companion-img {
      width: 125px;
      height: 125px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-companion-img {
      width: 155px;
      height: 155px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-companion-img {
      width: 185px;
      height: 185px;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-companion-img {
      width: 215px;
      height: 215px;
    }
  }

  #heroSlides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 25;
  }
  .hero-slide-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }
  .hero-slide-item img {
    height: 125%;
    max-height: 600px;
    width: auto;
    max-width: 90vw;
    object-fit: contain;
    filter: drop-shadow(0 32px 48px rgba(0, 0, 0, 0.72));
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .hero-slide-item img {
      height: 132%;
      max-height: 680px;
    }
  }
  @media (min-width: 768px) {
    .hero-slide-item img {
      height: 140%;
      max-height: 760px;
    }
  }
  @media (min-width: 1024px) {
    .hero-slide-item img {
      height: 148%;
      max-height: 840px;
    }
  }
  @media (min-width: 1280px) {
    .hero-slide-item img {
      height: 152%;
      max-height: 920px;
    }
  }

  .nidhi-cta-row {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    width: 100%;
  }
  .nidhi-cta-btn {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    border: 2px solid #FF3366 !important;
    background-color: #FF3366 !important;
    padding: 16px 44px;
    font-family: var(--font-display-family), "Fraunces", Georgia, serif !important;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7 !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .nidhi-cta-btn:hover {
    transform: scale(1.05);
    border-color: #E63946 !important;
    box-shadow: none !important;
  }
  .nidhi-cta-btn-bg {
    position: absolute;
    inset: 0;
    background-color: #FF3366;
    transition: background-color 0.3s;
    pointer-events: none;
  }
  .nidhi-cta-btn:hover .nidhi-cta-btn-bg {
    background-color: #E63946;
  }
  .nidhi-cta-text-wrap {
    position: relative;
    z-index: 20;
    display: block;
    overflow: hidden;
    height: 1.35em;
    line-height: 1.35em;
    pointer-events: none;
  }
  .nidhi-cta-text-top {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateY(0);
    opacity: 1;
    color: #f5e4c7;
  }
  .nidhi-cta-btn:hover .nidhi-cta-text-top {
    transform: translateY(-100%);
    opacity: 0;
  }
  .nidhi-cta-text-bottom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateY(100%);
    opacity: 0;
    color: #f5e4c7;
  }
  .nidhi-cta-btn:hover .nidhi-cta-text-bottom {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  (function () {
    /* ---------- SPLIT TEXT PLUGIN POLYFILL (FROM hero.html) ---------- */
    const SplitTextPlugin = window.SplitText || class {
      constructor(target, options = {}) {
        const elements = typeof target === "string" ? Array.from(document.querySelectorAll(target)) : (Array.isArray(target) ? target : [target]);
        this.chars = [];
        this.words = [];
        this.lines = [];

        elements.forEach((el) => {
          const wordsClass = options.wordsClass || "word";
          const charsClass = options.charsClass || "char";
          const includeChars = options.type && options.type.includes("chars");

          const processNode = (node, extraClasses = []) => {
            const fragment = document.createDocumentFragment();

            if (node.nodeType === 3) {
              const text = node.textContent;
              const wordsArr = text.split(/(\s+)/);

              wordsArr.forEach((part) => {
                if (/\s+/.test(part)) {
                  fragment.appendChild(document.createTextNode(part));
                  return;
                }
                if (!part) return;

                const wordSpan = document.createElement("span");
                wordSpan.className = [wordsClass, ...extraClasses].filter(Boolean).join(" ");
                wordSpan.style.display = "inline-block";

                if (includeChars) {
                  part.split("").forEach((char) => {
                    const charSpan = document.createElement("span");
                    charSpan.className = [charsClass, ...extraClasses].filter(Boolean).join(" ");
                    charSpan.style.display = "inline-block";
                    charSpan.textContent = char;
                    wordSpan.appendChild(charSpan);
                    this.chars.push(charSpan);
                  });
                } else {
                  wordSpan.textContent = part;
                }

                fragment.appendChild(wordSpan);
                this.words.push(wordSpan);
              });
            } else if (node.nodeType === 1) {
              if (node.tagName === "BR") {
                fragment.appendChild(node.cloneNode(true));
              } else {
                const elementClasses = Array.from(node.classList).filter(c => !["block", "flex", "grid", "hidden", "inline"].includes(c));
                const combinedClasses = [...extraClasses, ...elementClasses];
                Array.from(node.childNodes).forEach((child) => {
                  fragment.appendChild(processNode(child, combinedClasses));
                });
                if (node.classList.contains("block")) {
                  fragment.appendChild(document.createElement("br"));
                }
              }
            }

            return fragment;
          };

          const childNodes = Array.from(el.childNodes);
          el.innerHTML = "";
          childNodes.forEach((child) => {
            el.appendChild(processNode(child));
          });

          this.lines.push(el);
        });
      }

      static create(target, options) {
        return new SplitTextPlugin(target, options);
      }
    };

    /* ---------- HERO HEADING ENTRANCE ANIMATION (FROM hero.html) ---------- */
    function initHeroHeadingGsap() {
      if (typeof gsap === "undefined") {
        setTimeout(initHeroHeadingGsap, 50);
        return;
      }
      const titleEl = document.getElementById("heroTitle");
      if (!titleEl || titleEl.dataset.gsapInitialized) return;
      titleEl.dataset.gsapInitialized = "true";

      // Split heading into chars and set bouncy elastic pop on page load
      const heading = SplitTextPlugin.create("#heroTitle", {
        type: "lines, words, chars",
        charsClass: "char",
        wordsClass: "word",
      });

      gsap.fromTo(
        heading.chars,
        { y: 55, opacity: 0, scale: 0.45 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 1.2,
          stagger: 0.015,
          ease: "elastic.out(0.75, 0.25)",
          delay: 0.1,
        }
      );

      gsap.fromTo(
        ["#heroNo", "#heroName"],
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, stagger: 0.1, duration: 0.8, ease: "power3.out", delay: 0.4, clearProps: "transform,opacity" }
      );

      gsap.fromTo(
        "[data-hero]",
        { scale: 0, opacity: 0 },
        { scale: 1, opacity: 1, stagger: 0.12, duration: 0.7, ease: "back.out(1.8)", delay: 0.5 }
      );

      gsap.fromTo(
        [".nidhi-cta-row .button", ".nidhi-cta-btn"],
        { y: 25, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: "power3.out", delay: 0.55 }
      );
    }

    const SLIDES = [
      {
        name: "Classic Masala Chai",
        img: "{{ 'hero.png' | asset_url }}",
        tint: "var(--pink)",
        topIngredient: "{{ 'crisp_isolated_studio_macro_photography_of_exactly_one_single_ceylon_cinnamon-removebg-preview.png' | asset_url }}",
        bottomIngredient: "{{ 'ginger.webp' | asset_url }}"
      },
      {
        name: "Honey Lemon Green Tea",
        img: "{{ 'product-2.png' | asset_url }}",
        tint: "#2E6941",
        topIngredient: "{{ 'honey.webp' | asset_url }}",
        bottomIngredient: "{{ 'lemon.webp' | asset_url }}"
      },
      {
        name: "Rose Cardamom Black Tea",
        img: "{{ 'product-3.png' | asset_url }}",
        tint: "var(--red)",
        topIngredient: "{{ 'tea-leaf.webp' | asset_url }}",
        bottomIngredient: "{{ 'crisp_culinary_macro_photography_of_exactly_one_solitary_dehydrated_dried-removebg-preview.png' | asset_url }}"
      }
    ];

    function initHeroCarousel() {
      const wrap = document.getElementById("heroSlides");
      if (!wrap) return;

      const tint = document.getElementById("heroTint");
      const tintWrap = document.getElementById("heroTintWrap");
      const topWrap = document.getElementById("heroTopWrap");
      const bottomWrap = document.getElementById("heroBottomWrap");
      const topImg = document.getElementById("heroTopImg");
      const bottomImg = document.getElementById("heroBottomImg");
      const nameEl = document.getElementById("heroName");
      const noEl = document.getElementById("heroNo");
      const heroBtns = document.querySelectorAll("[data-hero]");
      const heroSection = document.getElementById("hero");
      let index = 0, autoplayTimer = null, btnPopupTimer = null, isTransitioning = false;

      wrap.innerHTML = SLIDES.map((s, i) => `
        <div class="hero-slide-item pointer-events-none absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform opacity-0" data-hero-slide="${i}">
          <img src="${s.img}" alt="${s.name}" class="hero-floating-pack pointer-events-none">
        </div>
      `).join("");
      const slides = [...wrap.querySelectorAll(".hero-slide-item")];

      function hideHeroBtns() {
        heroBtns.forEach((b) => {
          b.style.transition = "transform 220ms ease-out, opacity 220ms ease-out";
          b.style.transform = "scale(0)";
          b.style.opacity = "0";
          b.style.pointerEvents = "none";
        });
      }

      function popupHeroBtns() {
        clearTimeout(btnPopupTimer);
        btnPopupTimer = setTimeout(() => {
          heroBtns.forEach((b) => {
            b.style.transition = "transform 480ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 320ms ease";
            b.style.transform = "scale(1)";
            b.style.opacity = "1";
            b.style.pointerEvents = "auto";
          });
          isTransitioning = false;
        }, 620);
      }

      function render(animateEffects = false) {
        const n = SLIDES.length;

        if (animateEffects) {
          isTransitioning = true;
          hideHeroBtns();
          popupHeroBtns();

          // Step 1: Shrink & Dip down on slide exit (260ms)
          if (tintWrap) {
            tintWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1)";
            tintWrap.style.transform = "scale(0.85)";
          }

          if (topWrap) {
            topWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease";
            topWrap.style.transform = "scale(0) rotate(-35deg)";
            topWrap.style.opacity = "0";
          }
          if (bottomWrap) {
            bottomWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease";
            bottomWrap.style.transform = "scale(0) rotate(35deg)";
            bottomWrap.style.opacity = "0";
          }

          // Step 2: Swap color and spring back up to full size (550ms spring easing)
          setTimeout(() => {
            if (tint) {
              tint.style.background = SLIDES[index].tint;
              tint.style.boxShadow = "none";
            }

            if (tintWrap) {
              tintWrap.style.transition = "transform 550ms cubic-bezier(0.34, 1.56, 0.64, 1)";
              tintWrap.style.transform = "scale(1)";
            }

            if (topImg && bottomImg) {
              topImg.src = SLIDES[index].topIngredient;
              bottomImg.src = SLIDES[index].bottomIngredient;
            }

            if (topWrap) {
              topWrap.style.transition = "transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms ease";
              topWrap.style.transform = "scale(1) rotate(0deg)";
              topWrap.style.opacity = "1";
            }
            if (bottomWrap) {
              bottomWrap.style.transition = "transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms ease";
              bottomWrap.style.transform = "scale(1) rotate(0deg)";
              bottomWrap.style.opacity = "1";
            }
          }, 260);
        } else {
          if (tint) {
            tint.style.background = SLIDES[index].tint;
            tint.style.boxShadow = "none";
          }
          if (tintWrap) tintWrap.style.transform = "scale(1)";
          if (topWrap) { topWrap.style.transform = "scale(1)"; topWrap.style.opacity = "1"; }
          if (bottomWrap) { bottomWrap.style.transform = "scale(1)"; bottomWrap.style.opacity = "1"; }
          if (topImg) topImg.src = SLIDES[index].topIngredient;
          if (bottomImg) bottomImg.src = SLIDES[index].bottomIngredient;
        }

        slides.forEach((sl, i) => {
          let off = i - index;
          if (off > n / 2) off -= n;
          if (off < -n / 2) off += n;

          const isActive = off === 0;
          if (isActive) {
            sl.style.opacity = "1";
            sl.style.zIndex = "20";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(0, 0, 0) scale(1) rotate(0deg)";
          } else if (off < 0) {
            sl.style.opacity = "0";
            sl.style.zIndex = "10";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(-180%, 0, 0) scale(0.7) rotate(-10deg)";
          } else {
            sl.style.opacity = "0";
            sl.style.zIndex = "10";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(180%, 0, 0) scale(0.7) rotate(10deg)";
          }
        });

        if (nameEl) {
          // Update text and replay the fade-in animation
          nameEl.textContent = SLIDES[index].name;
          nameEl.classList.remove("animate-fade-in");
          void nameEl.offsetWidth; // Forces DOM reflow so animation restarts
          nameEl.classList.add("animate-fade-in");
        }
        if (noEl) {
          noEl.textContent = "Blend N0.0" + (index + 1);
        }
      }

      function go(step) {
        if (isTransitioning) return;
        index = (index + step + SLIDES.length) % SLIDES.length;
        render(true);
        resetAutoplay();
      }

      function resetAutoplay() {
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(() => {
          index = (index + 1) % SLIDES.length;
          render(true);
        }, 6000);
      }

      heroBtns.forEach((b) => {
        b.addEventListener("click", (e) => {
          e.stopPropagation();
          go(+b.dataset.hero);
        });
      });

      render(false);
      resetAutoplay();

      // Mobile Touch Swipe Navigation
      let touchStartX = 0, touchStartY = 0;
      const carouselContainer = wrap.parentElement;
      if (carouselContainer) {
        carouselContainer.addEventListener("touchstart", (e) => {
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }
        }, { passive: true });

        carouselContainer.addEventListener("touchend", (e) => {
          if (!touchStartX) return;
          const touchEndX = e.changedTouches[0].clientX;
          const touchEndY = e.changedTouches[0].clientY;
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
          if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX < 0) go(1);
            else go(-1);
          }
          touchStartX = 0;
          touchStartY = 0;
        }, { passive: true });
      }

      // Mouse Parallax on Hero Section
      if (heroSection && typeof gsap !== "undefined") {
        heroSection.addEventListener("mousemove", (e) => {
          const rect = heroSection.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;

          gsap.to(tintWrap, { x: x * 20, y: y * 20, duration: 0.8, ease: "power2.out" });
          gsap.to(wrap, { x: x * 12, y: y * 12, duration: 0.8, ease: "power2.out" });
        });

        heroSection.addEventListener("mouseleave", () => {
          gsap.to([tintWrap, wrap], { x: 0, y: 0, duration: 1, ease: "power2.out" });
        });
      }
    }

    function startInit() {
      initHeroCarousel();
      const loader = document.getElementById("loader");
      if (!loader) {
        initHeroHeadingGsap();
      } else {
        window.addEventListener("nidhi:loaderDone", initHeroHeadingGsap);
        setTimeout(initHeroHeadingGsap, 2600);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", startInit);
    } else {
      startInit();
    }
  })();
</script>

