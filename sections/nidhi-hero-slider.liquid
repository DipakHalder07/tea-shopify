  .nidhi-cta-row {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    width: 100%;
  }
  .nidhi-cta-btn {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    border: 2px solid #ff3366 !important;
    background-color: #ff3366 !important;
    padding: 16px 44px;
    font-family: var(--font-display-family), 'Fraunces', Georgia, serif !important;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7 !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .nidhi-cta-btn:hover {
    transform: scale(1.05);
    border-color: #e63946 !important;
