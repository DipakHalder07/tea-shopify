{% comment %}
  Nidhi Tea Hero Slider Section
  Faithfully ports the Hero design and interactive carousel from Nidhi Tea index.html
  - Massive title: "Sip Wellness. Taste Purity. Love Every Cup."
  - High-contrast 2px dotted rule lines across the page
  - Prominent vibrant pulsing circular background with floating breathing animation
  - Floating product pack with idle 3D tilt & vertical float
  - Smooth blend switching with shrink & bloom animations
{% endcomment %}

<section id="hero" class="nidhi-hero-section">
  <!-- Corner Botanical Tea Branches (Decorative Background) -->
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-tl" />
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-br" />

  <!-- Hero Main Heading (Extra Large & Imposing) -->
  <div class="nidhi-heading-wrap">
    <h1 id="heroTitle" class="nidhi-hero-title">
      <span class="text-outline">{{ section.settings.heading_outline | default: 'Sip Wellness.' }}</span>
      <span class="text-cream">{{ section.settings.heading_solid | default: 'Taste Purity. Love Every Cup.' }}</span>
    </h1>
  </div>

  <!-- Blend Indicator Rule Bar -->
  <div class="nidhi-blend-bar">
    <div class="dotted-rule" style="position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 0; transform: translateY(-50%); border-top: 2.5px dotted #f5e4c7; opacity: 0.85; z-index: 1; pointer-events: none;"></div>
    <div class="nidhi-blend-bar-inner">
      <span id="heroNo">Blend N0.01</span>
      <span id="heroName" class="animate-fade-in">Classic Masala Chai</span>
    </div>
  </div>

  <!-- ============ HERO CAROUSEL ROW WITH FULL-WIDTH DOTTED LINE ============ -->
  <div class="nidhi-carousel-row">
    <!-- Edge-to-Edge Full-Width Horizontal Dotted Line Behind Slider & Navigation Buttons -->
    <div class="dotted-rule" style="position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 0; transform: translateY(-50%); border-top: 2.5px dotted #f5e4c7; opacity: 0.85; z-index: 1; pointer-events: none;"></div>

    <div class="nidhi-carousel-inner">
      <!-- Previous Slide Button -->
      <button data-hero="-1" type="button" aria-label="Previous blend" class="nidhi-nav-btn">
        <span>&larr;</span>
      </button>

      <!-- Center Active Blend Presentation Stage -->
      <div class="nidhi-stage">
        <!-- Prominent Solid Center Color Tint Circle with Ambient Glow, Pulse & Float -->
        <div id="heroTintWrap">
          <div id="heroTint" class="animate-hero-bg"></div>
        </div>

        <!-- Top-Right & Bottom-Left Floating Botanical Companion Accents -->
        <div class="nidhi-companions-box">
          <!-- Top Right Companion (Shrink & Bloom on Slide Change) -->
          <div id="heroTopWrap" style="transform: scale(1);">
            <div class="animate-float-companion-top" style="pointer-events: none; display: flex; align-items: center; justify-content: center;">
              <img id="heroTopImg"
                src="{{ 'isolated_cinnamon_sticks_star_anise_and_dried_orange_slices_for_tea_flavoring.png' | asset_url }}"
                alt="Tea Spices"
                class="nidhi-companion-img" />
            </div>
          </div>

          <!-- Bottom Left Companion (Visible on sm+) -->
          <div id="heroBottomWrap" style="transform: scale(1);">
            <div class="animate-float-companion-bottom" style="pointer-events: none; display: flex; align-items: center; justify-content: center;">
              <img id="heroBottomImg"
                src="{{ 'isolated_vintage_silver_tea_strainer_with_loose_black_tea_leaves_transparent.png' | asset_url }}"
                alt="Tea Strainer"
                class="nidhi-companion-img" />
            </div>
          </div>
        </div>

        <!-- Dynamic Product Slide Packs -->
        <div id="heroSlides"></div>
      </div>

      <!-- Next Slide Button -->
      <button data-hero="1" type="button" aria-label="Next blend" class="nidhi-nav-btn">
        <span>&rarr;</span>
      </button>
    </div>
  </div>

  <!-- Bottom CTA Row With Dotted Line -->
  <div class="nidhi-cta-row">
    <div class="dotted-rule" style="position: absolute; left: 0; right: 0; top: 50%; width: 100%; height: 0; transform: translateY(-50%); border-top: 2.5px dotted #f5e4c7; opacity: 0.85; z-index: 1; pointer-events: none;"></div>
    <a href="{{ section.settings.button_link | default: '#products' }}" class="nidhi-cta-btn">
      <div class="nidhi-cta-btn-bg"></div>
      <span class="nidhi-cta-text-wrap">
        <span style="visibility: hidden; font-weight: 700; white-space: nowrap;">{{ section.settings.button_text | default: 'Explore Blends' }}</span>
        <span class="nidhi-cta-text-top">{{ section.settings.button_text | default: 'Explore Blends' }}</span>
        <span class="nidhi-cta-text-bottom">{{ section.settings.button_text | default: 'Explore Blends' }}</span>
      </span>
    </a>
  </div>
</section>

<style>
  .nidhi-hero-section {
    position: relative;
    overflow: hidden;
    padding-top: 30px;
    padding-bottom: 35px;
    background-color: var(--background, #100B06);
    color: var(--cream, #f5e4c7);
  }
  @media (min-width: 768px) {
    .nidhi-hero-section {
      padding-top: 45px;
      padding-bottom: 45px;
    }
  }

  .nidhi-branch-tl {
    position: absolute;
    top: -4rem;
    left: -5rem;
    width: 320px;
    height: auto;
    opacity: 0.14;
    transform: rotate(-45deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .nidhi-branch-br {
    position: absolute;
    bottom: -5rem;
    right: -6rem;
    width: 340px;
    height: auto;
    opacity: 0.14;
    transform: rotate(135deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  @media (min-width: 640px) {
    .nidhi-branch-tl { width: 560px; opacity: 0.16; }
    .nidhi-branch-br { width: 600px; opacity: 0.16; }
  }
  @media (min-width: 1024px) {
    .nidhi-branch-tl { width: 800px; }
    .nidhi-branch-br { width: 850px; }
  }

  /* Extra Large Grand Heading */
  .nidhi-heading-wrap {
    position: relative;
    z-index: 10;
    max-width: 1550px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    text-align: center;
  }
  .nidhi-hero-title {
    font-family: var(--font-display-family), "Fraunces", Georgia, serif !important;
    font-optical-sizing: auto;
    text-transform: uppercase;
    line-height: 0.88 !important;
    letter-spacing: -0.02em;
    font-weight: 800 !important;
    font-size: clamp(3rem, 8.8vw, 8.2rem) !important;
    margin: 0 auto;
    max-width: 1450px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .nidhi-hero-title {
      font-size: clamp(4.4rem, 7.8vw, 7.6rem) !important;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-hero-title {
      font-size: clamp(5.6rem, 7.5vw, 8.2rem) !important;
    }
  }
  .nidhi-hero-title .text-outline {
    color: transparent !important;
    -webkit-text-stroke: 2.2px #f5e4c7 !important;
  }
  .nidhi-hero-title .text-cream {
    color: #f5e4c7 !important;
  }

  /* Crisp High-Visibility Dotted Rule Styling */
  .dotted-rule {
    position: absolute;
    left: 0;
    right: 0;
    width: 100% !important;
    height: 0px !important;
    border-top: 2.5px dotted #f5e4c7 !important;
    background: none !important;
    opacity: 0.85 !important;
    pointer-events: none !important;
  }

  .nidhi-blend-bar {
    position: relative;
    z-index: 10;
    margin: 1.8rem 0 1rem 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar {
      margin: 2.2rem 0 1.2rem 0;
    }
  }
  .nidhi-blend-bar-inner {
    position: relative;
    z-index: 2;
    max-width: 1500px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    font-family: var(--font-display-family), "Fraunces", Georgia, serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7;
    font-weight: 700;
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar-inner {
      font-size: 16px;
      padding: 0 40px;
    }
  }
  .nidhi-blend-bar-inner span {
    background-color: #100B06;
  }
  .nidhi-blend-bar-inner #heroNo {
    padding-right: 1.2rem;
  }
  .nidhi-blend-bar-inner #heroName {
    padding-left: 1.2rem;
  }

  .nidhi-carousel-row {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0.8rem 0 1.2rem 0;
  }
  @media (min-width: 768px) {
    .nidhi-carousel-row {
      margin: 1.2rem 0 1.8rem 0;
    }
  }
  .nidhi-carousel-inner {
    position: relative;
    z-index: 10;
    max-width: 1500px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .nidhi-carousel-inner {
      padding: 0 40px;
      gap: 24px;
    }
  }

  .nidhi-nav-btn {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 2px solid #FF3366 !important;
    background-color: #FF3366 !important;
    color: #f5e4c7 !important;
    box-shadow: 0 10px 25px -5px rgba(255, 51, 102, 0.45);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    touch-action: manipulation;
  }
  @media (min-width: 640px) {
    .nidhi-nav-btn {
      width: 60px;
      height: 60px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-nav-btn {
      width: 72px;
      height: 72px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-nav-btn {
      width: 82px;
      height: 82px;
    }
  }
  .nidhi-nav-btn:hover {
    transform: scale(1.1);
    background-color: #E63946 !important;
    border-color: #E63946 !important;
    box-shadow: 0 12px 30px -5px rgba(230, 57, 70, 0.6);
  }
  .nidhi-nav-btn span {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .nidhi-nav-btn span {
      font-size: 1.7rem;
    }
  }

  .nidhi-stage {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 520px;
    min-height: 400px;
    max-height: 640px;
    overflow: visible;
  }
  @media (min-width: 640px) {
    .nidhi-stage {
      height: 560px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-stage {
      height: 600px;
    }
  }

  /* Center Color Tint Circle (Sized Generously with Rhythmic Breathing Pulse & Ambient Glow) */
  #heroTintWrap {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 550ms cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
    z-index: 5;
  }
  #heroTint {
    width: 320px;
    height: 320px;
    border-radius: 9999px;
    background-color: #FF3366;
    flex-shrink: 0;
    transition: background-color 700ms ease, box-shadow 700ms ease;
    box-shadow: 0 0 90px rgba(255, 51, 102, 0.55), 0 25px 60px -15px rgba(0, 0, 0, 0.8);
    will-change: transform, box-shadow;
  }
  @media (min-width: 640px) {
    #heroTint {
      width: 420px;
      height: 420px;
    }
  }
  @media (min-width: 768px) {
    #heroTint {
      width: 520px;
      height: 520px;
    }
  }
  @media (min-width: 1024px) {
    #heroTint {
      width: 600px;
      height: 600px;
    }
  }
  @media (min-width: 1280px) {
    #heroTint {
      width: 660px;
      height: 660px;
    }
  }

  /* Dynamic Zoom In / Zoom Out Breathing Animation on Product Background Circle */
  @keyframes hero-tint-zoom {
    0% {
      transform: scale(0.86);
      filter: drop-shadow(0 0 35px rgba(255, 51, 102, 0.45));
    }
    50% {
      transform: scale(1.14);
      filter: drop-shadow(0 0 95px rgba(255, 51, 102, 0.8));
    }
    100% {
      transform: scale(0.86);
      filter: drop-shadow(0 0 35px rgba(255, 51, 102, 0.45));
    }
  }
  @keyframes hero-bg-pulse {
    0%, 100% {
      transform: scale(0.86);
    }
    50% {
      transform: scale(1.14);
    }
  }
  .animate-hero-bg,
  #heroTint {
    animation: hero-tint-zoom 3.4s ease-in-out infinite !important;
    transform-origin: center center !important;
    will-change: transform, filter !important;
  }

  /* Floating Idle Animation on Product Pack (Tilt 5deg + Float) */
  @keyframes hero-pack-float {
    0%, 100% {
      transform: rotate(4deg) translateY(0px);
    }
    50% {
      transform: rotate(6.5deg) translateY(-18px);
    }
  }
  .hero-floating-pack {
    animation: hero-pack-float 4.5s ease-in-out infinite !important;
    will-change: transform;
    transform-origin: center center;
  }

  .nidhi-companions-box {
    position: absolute;
    inset: 0;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 320px;
    pointer-events: none;
    z-index: 20;
  }
  @media (min-width: 640px) { .nidhi-companions-box { max-width: 420px; } }
  @media (min-width: 768px) { .nidhi-companions-box { max-width: 500px; } }
  @media (min-width: 1024px) { .nidhi-companions-box { max-width: 600px; } }
  @media (min-width: 1280px) { .nidhi-companions-box { max-width: 680px; } }

  #heroTopWrap {
    position: absolute;
    top: -1.5rem;
    right: -1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }
  #heroBottomWrap {
    position: absolute;
    bottom: -1.5rem;
    left: -1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }

  .nidhi-companion-img {
    position: relative;
    z-index: 10;
    width: 80px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.6));
    pointer-events: none;
  }
  @media (min-width: 640px) { .nidhi-companion-img { width: 110px; } }
  @media (min-width: 768px) { .nidhi-companion-img { width: 140px; } }
  @media (min-width: 1024px) { .nidhi-companion-img { width: 180px; } }
  @media (min-width: 1280px) { .nidhi-companion-img { width: 210px; } }

  #heroSlides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 25;
  }
  .hero-slide-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }
  .hero-slide-item img {
    height: auto;
    max-height: 460px;
    width: auto;
    max-width: 85vw;
    object-fit: contain;
    filter: drop-shadow(0 25px 35px rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  @media (min-width: 640px) { .hero-slide-item img { max-height: 500px; } }
  @media (min-width: 1024px) { .hero-slide-item img { max-height: 540px; } }

  .nidhi-cta-row {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0;
    width: 100%;
  }
  .nidhi-cta-btn {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 14px;
    border: 2px solid #FF3366 !important;
    background-color: #FF3366 !important;
    padding: 16px 44px;
    font-family: var(--font-display-family), "Fraunces", Georgia, serif !important;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7 !important;
    text-decoration: none !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  .nidhi-cta-btn:hover {
    transform: scale(1.06);
    border-color: #E63946 !important;
    box-shadow: 0 20px 30px -5px rgba(255, 51, 102, 0.5);
  }
  .nidhi-cta-btn-bg {
    position: absolute;
    inset: 0;
    background-color: #FF3366;
    transition: background-color 0.3s;
    pointer-events: none;
  }
  .nidhi-cta-btn:hover .nidhi-cta-btn-bg {
    background-color: #E63946;
  }
  .nidhi-cta-text-wrap {
    position: relative;
    z-index: 20;
    display: block;
    overflow: hidden;
    height: 1.35em;
    line-height: 1.35em;
    pointer-events: none;
  }
  .nidhi-cta-text-top {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateY(0);
    opacity: 1;
    color: #f5e4c7;
  }
  .nidhi-cta-btn:hover .nidhi-cta-text-top {
    transform: translateY(-100%);
    opacity: 0;
  }
  .nidhi-cta-text-bottom {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateY(100%);
    opacity: 0;
    color: #f5e4c7;
  }
  .nidhi-cta-btn:hover .nidhi-cta-text-bottom {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  (function () {
    const SLIDES = [
      {
        name: "Classic Masala Chai",
        img: "{{ 'hero.png' | asset_url }}",
        tint: "#FF3366",
        glow: "0 0 90px rgba(255, 51, 102, 0.55), 0 25px 60px -15px rgba(0, 0, 0, 0.8)",
        topIngredient: "{{ 'isolated_cinnamon_sticks_star_anise_and_dried_orange_slices_for_tea_flavoring.png' | asset_url }}",
        bottomIngredient: "{{ 'isolated_vintage_silver_tea_strainer_with_loose_black_tea_leaves_transparent.png' | asset_url }}"
      },
      {
        name: "Honey Lemon Green Tea",
        img: "{{ 'product-2.png' | asset_url }}",
        tint: "#2E6941",
        glow: "0 0 90px rgba(46, 105, 65, 0.55), 0 25px 60px -15px rgba(0, 0, 0, 0.8)",
        topIngredient: "{{ 'isolated_honey_dipper_with_dripping_golden_honey_transparent_background.png' | asset_url }}",
        bottomIngredient: "{{ 'isolated_fresh_green_tea_leaves_with_water_droplets_macro_photography.png' | asset_url }}"
      },
      {
        name: "Rose Cardamom Black Tea",
        img: "{{ 'product-3.png' | asset_url }}",
        tint: "#E63946",
        glow: "0 0 90px rgba(230, 57, 70, 0.55), 0 25px 60px -15px rgba(0, 0, 0, 0.8)",
        topIngredient: "{{ 'green_cardamom.png' | asset_url }}",
        bottomIngredient: "{{ 'star_anise.png' | asset_url }}"
      }
    ];

    function initHeroCarousel() {
      const wrap = document.getElementById("heroSlides");
      if (!wrap) return;

      const tint = document.getElementById("heroTint");
      const tintWrap = document.getElementById("heroTintWrap");
      const topWrap = document.getElementById("heroTopWrap");
      const bottomWrap = document.getElementById("heroBottomWrap");
      const topImg = document.getElementById("heroTopImg");
      const bottomImg = document.getElementById("heroBottomImg");
      const nameEl = document.getElementById("heroName");
      const noEl = document.getElementById("heroNo");
      const heroBtns = document.querySelectorAll("[data-hero]");
      const heroSection = document.getElementById("hero");
      let index = 0, autoplayTimer = null, btnPopupTimer = null, isTransitioning = false;

      wrap.innerHTML = SLIDES.map((s, i) => `
        <div class="hero-slide-item pointer-events-none absolute inset-0 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-transform opacity-0" data-hero-slide="${i}">
          <img src="${s.img}" alt="${s.name}" class="hero-floating-pack pointer-events-none">
        </div>
      `).join("");
      const slides = [...wrap.querySelectorAll(".hero-slide-item")];

      function hideHeroBtns() {
        heroBtns.forEach((b) => {
          b.style.transition = "transform 220ms ease-out, opacity 220ms ease-out";
          b.style.transform = "scale(0)";
          b.style.opacity = "0";
          b.style.pointerEvents = "none";
        });
      }

      function popupHeroBtns() {
        clearTimeout(btnPopupTimer);
        btnPopupTimer = setTimeout(() => {
          heroBtns.forEach((b) => {
            b.style.transition = "transform 480ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 320ms ease";
            b.style.transform = "scale(1)";
            b.style.opacity = "1";
            b.style.pointerEvents = "auto";
          });
          isTransitioning = false;
        }, 620);
      }

      function render(animateEffects = false) {
        const n = SLIDES.length;

        if (animateEffects) {
          isTransitioning = true;
          hideHeroBtns();
          popupHeroBtns();

          if (tintWrap) {
            tintWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1)";
            tintWrap.style.transform = "scale(0.82)";
          }

          if (topWrap) {
            topWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease";
            topWrap.style.transform = "scale(0) rotate(-35deg)";
            topWrap.style.opacity = "0";
          }
          if (bottomWrap) {
            bottomWrap.style.transition = "transform 260ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease";
            bottomWrap.style.transform = "scale(0) rotate(35deg)";
            bottomWrap.style.opacity = "0";
          }

          setTimeout(() => {
            if (tint) {
              tint.style.backgroundColor = SLIDES[index].tint;
              tint.style.boxShadow = SLIDES[index].glow;
            }

            if (tintWrap) {
              tintWrap.style.transition = "transform 550ms cubic-bezier(0.34, 1.56, 0.64, 1)";
              tintWrap.style.transform = "scale(1)";
            }

            if (topImg && bottomImg) {
              topImg.src = SLIDES[index].topIngredient;
              bottomImg.src = SLIDES[index].bottomIngredient;
            }

            if (topWrap) {
              topWrap.style.transition = "transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms ease";
              topWrap.style.transform = "scale(1) rotate(0deg)";
              topWrap.style.opacity = "1";
            }
            if (bottomWrap) {
              bottomWrap.style.transition = "transform 520ms cubic-bezier(0.34, 1.56, 0.64, 1), opacity 300ms ease";
              bottomWrap.style.transform = "scale(1) rotate(0deg)";
              bottomWrap.style.opacity = "1";
            }
          }, 260);
        } else {
          if (tint) {
            tint.style.backgroundColor = SLIDES[index].tint;
            tint.style.boxShadow = SLIDES[index].glow;
          }
          if (tintWrap) tintWrap.style.transform = "scale(1)";
          if (topWrap) { topWrap.style.transform = "scale(1)"; topWrap.style.opacity = "1"; }
          if (bottomWrap) { bottomWrap.style.transform = "scale(1)"; bottomWrap.style.opacity = "1"; }
          if (topImg) topImg.src = SLIDES[index].topIngredient;
          if (bottomImg) bottomImg.src = SLIDES[index].bottomIngredient;
        }

        slides.forEach((sl, i) => {
          let off = i - index;
          if (off > n / 2) off -= n;
          if (off < -n / 2) off += n;

          const isActive = off === 0;
          if (isActive) {
            sl.style.opacity = "1";
            sl.style.zIndex = "20";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(0, 0, 0) scale(1) rotate(0deg)";
          } else if (off < 0) {
            sl.style.opacity = "0";
            sl.style.zIndex = "10";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(-180%, 0, 0) scale(0.7) rotate(-10deg)";
          } else {
            sl.style.opacity = "0";
            sl.style.zIndex = "10";
            sl.style.pointerEvents = "none";
            sl.style.transform = "translate3d(180%, 0, 0) scale(0.7) rotate(10deg)";
          }
        });

        if (nameEl) {
          nameEl.textContent = SLIDES[index].name;
          nameEl.classList.remove("animate-fade-in");
          void nameEl.offsetWidth;
          nameEl.classList.add("animate-fade-in");
        }
        if (noEl) {
          noEl.textContent = "Blend N0.0" + (index + 1);
        }
      }

      function go(step) {
        if (isTransitioning) return;
        index = (index + step + SLIDES.length) % SLIDES.length;
        render(true);
        resetAutoplay();
      }

      function resetAutoplay() {
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(() => {
          index = (index + 1) % SLIDES.length;
          render(true);
        }, 6000);
      }

      heroBtns.forEach((b) => {
        b.addEventListener("click", (e) => {
          e.stopPropagation();
          go(+b.dataset.hero);
        });
      });
      render(false);
      resetAutoplay();

      // Mobile Touch Swipe Navigation
      let touchStartX = 0, touchStartY = 0;
      const carouselContainer = wrap.parentElement;
      if (carouselContainer) {
        carouselContainer.addEventListener("touchstart", (e) => {
          if (e.touches && e.touches[0]) {
            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
          }
        }, { passive: true });

        carouselContainer.addEventListener("touchend", (e) => {
          if (!touchStartX) return;
          const touchEndX = e.changedTouches[0].clientX;
          const touchEndY = e.changedTouches[0].clientY;
          const diffX = touchEndX - touchStartX;
          const diffY = touchEndY - touchStartY;
          if (Math.abs(diffX) > 35 && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX < 0) go(1);
            else go(-1);
          }
          touchStartX = 0;
          touchStartY = 0;
        }, { passive: true });
      }

      // Mouse Parallax on Hero Section
      if (heroSection && typeof gsap !== "undefined") {
        heroSection.addEventListener("mousemove", (e) => {
          const rect = heroSection.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;

          gsap.to(tintWrap, { x: x * 20, y: y * 20, duration: 0.8, ease: "power2.out" });
          gsap.to(wrap, { x: x * 12, y: y * 12, duration: 0.8, ease: "power2.out" });
        });

        heroSection.addEventListener("mouseleave", () => {
          gsap.to([tintWrap, wrap], { x: 0, y: 0, duration: 1, ease: "power2.out" });
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHeroCarousel);
    } else {
      initHeroCarousel();
    }
  })();
</script>

