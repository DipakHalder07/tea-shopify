{% comment %}
  Nidhi Tea Hero Slider Section
  Faithfully ports the Hero design and interactive carousel from Nidhi Tea index.html
  - Massive title: "Sip Wellness. Taste Purity. Love Every Cup."
  - High-contrast 2px dotted rule lines across the page
  - Prominent vibrant pulsing circular background with floating breathing animation
  - Floating product pack with idle 3D tilt & vertical float
  - Smooth blend switching with shrink & bloom animations
{% endcomment %}

<section id="hero" class="nidhi-hero-section">
  <!-- Corner Botanical Tea Branches (Decorative Background) -->
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-tl" />
  <img src="{{ 'botanical-tea-branch.svg' | asset_url }}" alt="" aria-hidden="true" class="nidhi-branch-br" />

  <!-- Hero Main Heading (3 Distinct Dramatic Lines) -->
  <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
    <div class="row">
      <div class="nidhi-heading-wrap">
        <h1 id="heroTitle" class="nidhi-hero-title">
          <span class="text-outline block">
            {{-
              section.settings.heading_line_1
              | default: section.settings.heading_outline
              | default: 'Sip Wellness.'
            -}}
          </span>
          <span class="text-cream block">{{ section.settings.heading_line_2 | default: 'Taste Purity.' }}</span>
          <span class="text-cream block">{{ section.settings.heading_line_3 | default: 'Love Every Cup.' }}</span>
        </h1>
      </div>
    </div>
  </div>

  <!-- Blend Indicator Rule Bar -->
  <div class="nidhi-blend-bar">
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>
    <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
      <div class="row">
        <div class="nidhi-blend-bar-inner">
          <span id="heroNo">Blend N0.01</span>
          <span id="heroName" class="animate-fade-in">Classic Masala Chai</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ HERO CAROUSEL ROW WITH FULL-WIDTH DOTTED LINE ============ -->
  <div class="nidhi-carousel-row">
    <!-- Edge-to-Edge Full-Width Horizontal Dotted Line Behind Slider & Navigation Buttons -->
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>

    <div class="{% if section.settings.page_full_width %} page-full-width {% else %} page-width {% endif %} {% if section.settings.page_full_width_spacing %} page-full-width_spacing {% endif %}">
      <div class="row">
        <div class="nidhi-carousel-inner">
          <!-- Previous Slide Button -->
          <button data-hero="-1" type="button" aria-label="Previous blend" class="nidhi-nav-btn">
            <span class="nidhi-nav-icon nidhi-nav-icon--prev">
              {% render 'icon-arrow' %}
            </span>
          </button>

          <!-- Center Active Blend Presentation Stage -->
          <div class="nidhi-stage">
            <!-- Wrapper for transition & parallax -->
            <div
              id="heroTintWrap"
              class="absolute flex items-center justify-center pointer-events-none transition-transform duration-500 will-change-transform"
              style="transform: scale(1);"
            >
              <!-- The Animated Pulsating Background Circle -->
              <div
                id="heroTint"
                class="h-56 w-56 rounded-full transition-colors duration-700 sm:h-72 sm:w-72 md:h-[400px] md:w-[400px] lg:h-[480px] lg:w-[480px] xl:h-[560px] xl:w-[560px] animate-hero-bg shadow-2xl"
                style="background: var(--pink, #FF3366);"
              >&zwnj;</div>
            </div>

            <!-- Top-Left Floating Botanical Companion (Behind Product Pack: z-index 15) -->
            <div class="nidhi-companion-container nidhi-companion-container--behind">
              <div id="heroTopWrap" style="transform: scale(1);">
                <div
                  class="animate-float-companion-top"
                  style="pointer-events: none; display: flex; align-items: center; justify-content: center;"
                >
                  <img
                    id="heroTopImg"
                    src="{{ 'regenerate_the_fresh_green_tea_leaves_sprig_from_the_reference_image_data_image-removebg-preview.png' | asset_url }}"
                    alt="Green Tea Sprig"
                    class="nidhi-companion-img nidhi-companion-img--top"
                  />
                </div>
              </div>
            </div>

            <!-- Dynamic Product Slide Packs (Midground: z-index 25) -->
            <div id="heroSlides"></div>

            <!-- Bottom-Right Floating Botanical Companion (In Front / Closer: z-index 30) -->
            <div class="nidhi-companion-container nidhi-companion-container--front">
              <div id="heroBottomWrap" style="transform: scale(1);">
                <div
                  class="animate-float-companion-bottom"
                  style="pointer-events: none; display: flex; align-items: center; justify-content: center;"
                >
                  <img
                    id="heroBottomImg"
                    src="{{ 'isolate_and_generate_a_single_separate_asset_a_traditional_terracotta_clay_cup-removebg-preview.png' | asset_url }}"
                    alt="Clay Cup"
                    class="nidhi-companion-img nidhi-companion-img--bottom"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Next Slide Button -->
          <button data-hero="1" type="button" aria-label="Next blend" class="nidhi-nav-btn">
            <span class="nidhi-nav-icon nidhi-nav-icon--next">
              {% render 'icon-arrow' %}
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA Row With Dotted Line -->
  <div class="nidhi-cta-row">
    <div class="dotted-rule" aria-hidden="true">&zwnj;</div>
    <div class="nidhi-cta-pill-box">
      <a
        href="{{ section.settings.button_link | default: routes.all_products_collection_url | default: '/collections/all' }}"
        class="button button--primary"
      >
        {{ section.settings.button_text | default: 'Shop New' }}
      </a>
    </div>
  </div>
</section>

<style>
  .nidhi-hero-section {
    position: relative;
    overflow: hidden;
    padding-top: 30px;
    padding-bottom: 35px;
    background-color: var(--background, #100b06);
    color: var(--cream, #f5e4c7);
  }
  @media (min-width: 768px) {
    .nidhi-hero-section {
      padding-top: 45px;
      padding-bottom: 45px;
    }
  }

  .nidhi-branch-tl {
    position: absolute;
    top: -4rem;
    left: -5rem;
    width: 320px;
    height: auto;
    opacity: 0.14;
    transform: rotate(-45deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .nidhi-branch-br {
    position: absolute;
    bottom: -5rem;
    right: -6rem;
    width: 340px;
    height: auto;
    opacity: 0.14;
    transform: rotate(135deg);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  @media (min-width: 640px) {
    .nidhi-branch-tl {
      width: 560px;
      opacity: 0.16;
    }
    .nidhi-branch-br {
      width: 600px;
      opacity: 0.16;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-branch-tl {
      width: 800px;
    }
    .nidhi-branch-br {
      width: 850px;
    }
  }

  /* Container inner elements aligned with Shopify header container */
  .nidhi-heading-wrap {
    position: relative;
    z-index: 10;
    max-width: 1650px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    text-align: center;
  }
  @media (max-width: 767px) {
    .nidhi-heading-wrap {
      padding: 0 12px;
    }
  }
  .nidhi-hero-title {
    font-family: var(--font-display-family), 'Fraunces', Georgia, serif !important;
    font-optical-sizing: auto;
    text-transform: uppercase;
    line-height: 0.86 !important;
    letter-spacing: -0.025em;
    font-weight: 800 !important;
    font-size: clamp(3.2rem, 11vw, 5.5rem) !important;
    margin: 0 auto;
    max-width: 1650px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .nidhi-hero-title {
      font-size: clamp(5.5rem, 9.8vw, 8.8rem) !important;
      line-height: 0.85 !important;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-hero-title {
      font-size: clamp(7.5rem, 9.6vw, 11.2rem) !important;
      line-height: 0.84 !important;
    }
  }
  .nidhi-hero-title .text-outline {
    color: transparent !important;
    -webkit-text-stroke: 2.5px #f5e4c7 !important;
  }
  @media (min-width: 1024px) {
    .nidhi-hero-title .text-outline {
      -webkit-text-stroke: 3px #f5e4c7 !important;
    }
  }
  .nidhi-hero-title .text-cream {
    color: #f5e4c7 !important;
  }

  #heroTitle .char,
  #heroTitle .word {
    display: inline-block;
    will-change: transform, opacity;
  }

  /* Dotted Rule Styling - Explicit display: block to override theme div:empty { display: none } */
  .dotted-rule,
  div.dotted-rule,
  div.dotted-rule:empty,
  .dotted-rule:empty {
    display: block !important;
    height: 1px !important;
    width: 100% !important;
    background-image: repeating-linear-gradient(
      to right,
      rgba(245, 228, 199, 0.45) 0px,
      rgba(245, 228, 199, 0.45) 4px,
      transparent 4px,
      transparent 10px
    ) !important;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    line-height: 0;
    font-size: 0;
  }

  /* Animation Name: bucks-fade */
  @keyframes bucks-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: bucks-fade 0.5s ease-out both;
  }

  #heroNo {
    background-color: var(--background, #100b06);
    padding-right: 1.25rem;
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  #heroName {
    background-color: var(--background, #100b06);
    padding-left: 1.25rem;
    position: relative;
    z-index: 2;
    display: inline-block;
  }

  @media (max-width: 767px) {
    #heroNo {
      display: none !important;
    }
    .nidhi-blend-bar-inner {
      justify-content: center !important;
      text-align: center !important;
      padding: 0 10px;
    }
    #heroName {
      padding-left: 1.25rem !important;
      padding-right: 1.25rem !important;
      text-align: center !important;
      margin: 0 auto !important;
    }
  }

  .nidhi-cta-pill-box {
    position: relative;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    background-color: var(--background, #100b06);
    padding: 0 1.25rem;
  }

  .nidhi-blend-bar {
    position: relative;
    z-index: 10;
    margin: 1.8rem 0 1rem 0;
    width: 100%;
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar {
      margin: 2.2rem 0 1.2rem 0;
    }
  }
  .nidhi-blend-bar-inner {
    position: relative;
    z-index: 2;
    max-width: var(--large_desktop, 1500px);
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-display-family), 'Fraunces', Georgia, serif;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #f5e4c7;
    font-weight: 700;
  }
  @media (max-width: 767px) {
    .nidhi-blend-bar-inner {
      padding: 0 10px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-blend-bar-inner {
      font-size: 16px;
    }
  }

  .nidhi-carousel-row {
    position: relative;
    z-index: 10;
    width: 100%;
    margin: 0.8rem 0 1.2rem 0;
  }
  @media (min-width: 768px) {
    .nidhi-carousel-row {
      margin: 1.2rem 0 1.8rem 0;
    }
  }
  .nidhi-carousel-inner {
    position: relative;
    z-index: 10;
    max-width: var(--large_desktop, 1500px);
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  @media (max-width: 767px) {
    .nidhi-carousel-inner {
      padding: 0 10px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-carousel-inner {
      gap: 24px;
    }
  }

  .nidhi-nav-btn {
    position: relative;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 9999px;
    border: 2px solid #ff3366 !important;
    background-color: #ff3366 !important;
    color: #f5e4c7 !important;
    box-shadow: none !important;
    -webkit-box-shadow: none !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    touch-action: manipulation;
  }
  @media (min-width: 640px) {
    .nidhi-nav-btn {
      width: 60px;
      height: 60px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-nav-btn {
      width: 72px;
      height: 72px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-nav-btn {
      width: 82px;
      height: 82px;
    }
  }
  .nidhi-nav-btn:hover {
    transform: scale(1.1);
    background-color: #e63946 !important;
    border-color: #e63946 !important;
    box-shadow: none !important;
    -webkit-box-shadow: none !important;
  }
  .nidhi-nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nidhi-nav-icon--prev {
    transform: scaleX(-1);
  }
  .nidhi-nav-icon svg,
  .nidhi-nav-icon .icon-arrow,
  .nidhi-nav-icon .icon-hero-arrow {
    width: 20px;
    height: 15px;
    color: #f5e4c7 !important;
    fill: currentColor !important;
    display: block;
  }
  @media (min-width: 640px) {
    .nidhi-nav-icon svg,
    .nidhi-nav-icon .icon-arrow,
    .nidhi-nav-icon .icon-hero-arrow {
      width: 26px;
      height: 19px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-nav-icon svg,
    .nidhi-nav-icon .icon-arrow,
    .nidhi-nav-icon .icon-hero-arrow {
      width: 32px;
      height: 23px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-nav-icon svg,
    .nidhi-nav-icon .icon-arrow,
    .nidhi-nav-icon .icon-hero-arrow {
      width: 36px;
      height: 26px;
    }
  }
  .nidhi-nav-btn[data-hero="-1"]:hover .nidhi-nav-icon {
    transform: scaleX(-1) translateX(5px);
  }
  .nidhi-nav-btn[data-hero="1"]:hover .nidhi-nav-icon {
    transform: translateX(5px);
  }

  .nidhi-stage {
    position: relative;
    z-index: 10;
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    height: 52vh;
    min-height: 420px;
    max-height: 620px;
    max-width: 520px;
    margin: 0 auto;
    overflow: visible;
  }
  @media (min-width: 640px) {
    .nidhi-stage {
      height: 56vh;
      min-height: 460px;
      max-height: 660px;
      max-width: 600px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-stage {
      height: 60vh;
      min-height: 500px;
      max-height: 700px;
      max-width: 660px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-stage {
      height: 64vh;
      min-height: 540px;
      max-height: 740px;
      max-width: 720px;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-stage {
      height: 66vh;
      min-height: 580px;
      max-height: 780px;
      max-width: 760px;
    }
  }

  /* Center Color Tint Circle (Sized Generously with Rhythmic Breathing Pulse & Ambient Glow) */
  #heroTintWrap {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition-property: transform;
    transition-duration: 500ms;
    will-change: transform;
    z-index: 5;
  }
  #heroTint {
    display: block !important;
    width: 12rem;
    height: 12rem;
    border-radius: 9999px;
    background-color: var(--pink, #FF3366);
    background-image: none !important;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4) !important;
    flex-shrink: 0;
    transition: background-color 900ms ease, background 900ms ease;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroTint {
      width: 15rem;
      height: 15rem;
    }
  }
  @media (min-width: 768px) {
    #heroTint {
      width: 320px;
      height: 320px;
    }
  }
  @media (min-width: 1024px) {
    #heroTint {
      width: 380px;
      height: 380px;
    }
  }
  @media (min-width: 1280px) {
    #heroTint {
      width: 440px;
      height: 440px;
    }
  }

  /* Animation Name: hero-bg-pulse */
  @keyframes hero-bg-pulse {
    0%,
    100% {
      transform: scale(0.97);
    }
    50% {
      transform: scale(1.03);
    }
  }

  /* Class applied to the background circle */
  .animate-hero-bg {
    animation: hero-bg-pulse 8.5s ease-in-out infinite !important;
    will-change: transform;
  }

  /* Floating Idle Animation on Product Pack - Slower and Gentler */
  @keyframes hero-pack-float {
    0%,
    100% {
      transform: rotate(3deg) translateY(0px);
    }
    50% {
      transform: rotate(4.8deg) translateY(-14px);
    }
  }
  .hero-floating-pack {
    animation: hero-pack-float 7.5s ease-in-out infinite !important;
    will-change: transform;
    transform-origin: center center;
  }

  /* Companion containers: sized closer to product pack */
  .nidhi-companion-container {
    position: absolute;
    inset: 0;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 260px;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .nidhi-companion-container {
      max-width: 340px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-companion-container {
      max-width: 400px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-companion-container {
      max-width: 460px;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-companion-container {
      max-width: 520px;
    }
  }

  .nidhi-companion-container--behind {
    z-index: 15;
  }
  .nidhi-companion-container--front {
    z-index: 30;
  }

  /* 1 Top-Left Corner Behind Product Pack */
  #heroTopWrap {
    position: absolute;
    top: 4%;
    left: 2%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroTopWrap {
      top: 6%;
      left: 3%;
    }
  }
  @media (min-width: 1024px) {
    #heroTopWrap {
      top: 7%;
      left: 4%;
    }
  }

  /* 1 Bottom-Right Corner In Front / Closer to Product Pack */
  #heroBottomWrap {
    position: absolute;
    bottom: 4%;
    right: 2%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    will-change: transform;
  }
  @media (min-width: 640px) {
    #heroBottomWrap {
      bottom: 6%;
      right: 3%;
    }
  }
  @media (min-width: 1024px) {
    #heroBottomWrap {
      bottom: 7%;
      right: 4%;
    }
  }

  /* Floating Keyframes for Companions */
  @keyframes companion-float-tl {
    0%,
    100% {
      transform: translateY(0px) rotate(-3deg);
    }
    50% {
      transform: translateY(-10px) rotate(3deg);
    }
  }
  .animate-float-companion-top {
    animation: companion-float-tl 5s ease-in-out infinite;
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  @keyframes companion-float-br {
    0%,
    100% {
      transform: translateY(0px) rotate(3deg);
    }
    50% {
      transform: translateY(10px) rotate(-3deg);
    }
  }
  .animate-float-companion-bottom {
    animation: companion-float-br 7.5s ease-in-out infinite 1s;
    will-change: transform;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .nidhi-companion-img {
    position: relative;
    width: 75px;
    height: 75px;
    object-fit: contain;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .nidhi-companion-img {
      width: 105px;
      height: 105px;
    }
  }
  @media (min-width: 768px) {
    .nidhi-companion-img {
      width: 130px;
      height: 130px;
    }
  }
  @media (min-width: 1024px) {
    .nidhi-companion-img {
      width: 155px;
      height: 155px;
    }
  }
  @media (min-width: 1280px) {
    .nidhi-companion-img {
      width: 175px;
      height: 175px;
    }
  }

  #heroSlides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 25;
  }
  .hero-slide-item {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 1200ms cubic-bezier(0.25, 1, 0.35, 1);
    will-change: transform, opacity;
  }
  .hero-slide-item img {
    height: 102%;
