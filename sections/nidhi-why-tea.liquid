<script>
  (function () {
    function initWhyNidhi() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initWhyNidhi, 60);
        return;
      }
      gsap.registerPlugin(ScrollTrigger);

      const root = document.getElementById('nidhiWhyTeaComponent');
      if (!root || root.dataset.whyInitialized) return;
      root.dataset.whyInitialized = 'true';

      /* ---------- 1. STANDALONE ARCHED HEADING REVEAL ---------- */
      const introSection = root.querySelector('#whyIntroSection');
      if (introSection) {
        gsap.from(introSection.querySelector('.why-arc-headline-box'), {
          scrollTrigger: {
            trigger: introSection,
            start: 'top 80%',
            toggleActions: 'play none none reverse',
          },
          y: 60,
          scale: 0.92,
          opacity: 0,
          duration: 1.2,
          ease: 'power3.out',
        });

        const sub = introSection.querySelector('.why-intro-subtitle');
        if (sub) {
          gsap.from(sub, {
            scrollTrigger: {
              trigger: introSection,
              start: 'top 75%',
              toggleActions: 'play none none reverse',
            },
            y: 35,
            opacity: 0,
            duration: 1,
            delay: 0.25,
            ease: 'power3.out',
          });
        }

        const glow = introSection.querySelector('#whyIntroGlow');
        if (glow) {
          gsap.to(glow, {
            scale: 1.18,
            opacity: 0.9,
            duration: 3.5,
            repeat: -1,
            yoyo: true,
            ease: 'sine.inOut',
          });
        }
      }

      /* ---------- 2. ROUND ORBITAL ARC ON-SCROLL SCRUB ---------- */
      const whySec = root.querySelector('#whySection');
      if (!whySec) return;

      function getXDist() {
        return window.innerWidth < 768 ? window.innerWidth * 0.96 : window.innerWidth * 0.72;
      }
      function getYDrop() {
        return window.innerWidth < 768 ? 130 : 210;
      }
      function getRot() {
        return window.innerWidth < 768 ? 10 : 14;
      }

      // Base placement: all slides centered horizontally & vertically on orbital peak
      gsap.set(whySec.querySelectorAll('.why-slide'), {
        left: '50%',
        top: '46%',
        xPercent: -50,
        yPercent: -50,
        opacity: 1,
        transformOrigin: 'center center',
      });

      // Initial positions along the arc
      gsap.set(whySec.querySelector('.slide-1'), {
        x: 0,
        y: 0,
        rotation: 0,
      });

      gsap.set(whySec.querySelector('.slide-2'), {
        x: () => getXDist(),
        y: () => getYDrop(),
        rotation: () => getRot(),
      });

      gsap.set(whySec.querySelector('.slide-3'), {
        x: () => getXDist() * 1.85,
        y: () => getYDrop() * 2.2,
        rotation: () => getRot() * 1.85,
      });

      // Scroll-scrubbed GSAP Timeline along the round orbital arc
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: whySec,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            updateWhyMobile(self.progress);
          },
        },
        defaults: { ease: 'none' },
      });

      // Phase 1 (0 -> 1): Slide 1 descends left along arc; Slide 2 crests to center
      tl.to(
        whySec.querySelector('.slide-1'),
        {
          x: () => -getXDist(),
          y: () => getYDrop(),
          rotation: () => -getRot(),
          duration: 1,
        },
        0
      );

      tl.to(
        whySec.querySelector('.slide-2'),
        {
          x: 0,
          y: 0,
          rotation: 0,
          duration: 1,
        },
        0
      );

      tl.to(
        whySec.querySelector('.slide-3'),
        {
          x: () => getXDist(),
          y: () => getYDrop(),
          rotation: () => getRot(),
          duration: 1,
        },
        0
      );

      // Phase 2 (1 -> 2): Slide 2 descends left along arc; Slide 3 crests to center
      tl.to(
        whySec.querySelector('.slide-1'),
        {
          x: () => -getXDist() * 1.85,
          y: () => getYDrop() * 2.2,
          rotation: () => -getRot() * 1.85,
          duration: 1,
        },
        1
      );

      tl.to(
        whySec.querySelector('.slide-2'),
        {
          x: () => -getXDist(),
          y: () => getYDrop(),
          rotation: () => -getRot(),
          duration: 1,
        },
        1
      );

      tl.to(
        whySec.querySelector('.slide-3'),
        {
          x: 0,
          y: 0,
          rotation: 0,
          duration: 1,
        },
        1
      );

      // Dotted orbital arc line scrubbing smoothly along the curve
      tl.fromTo(
        whySec.querySelector('.why-line'),
        { strokeDashoffset: 0 },
        { strokeDashoffset: -1600, duration: 2, ease: 'none' },
        0
      );

      // Mobile Slider Controls & Touch Swiping Engine
      let currentWhySlide = 0;
      function updateWhyMobile(progress) {
        const idx = Math.min(2, Math.max(0, Math.round(progress * 2)));
        if (idx === currentWhySlide) return;
        currentWhySlide = idx;

        const prevBtn = whySec.querySelector('#whyMobilePrev');
        const nextBtn = whySec.querySelector('#whyMobileNext');
        if (prevBtn) prevBtn.style.opacity = idx === 0 ? '0.35' : '1';
        if (nextBtn) nextBtn.style.opacity = idx === 2 ? '0.35' : '1';
      }

      function goToWhySlide(targetIndex) {
        targetIndex = Math.max(0, Math.min(2, targetIndex));
        const st = tl.scrollTrigger;
        if (!st) return;
        const targetProgress = targetIndex / 2;
        const targetY = st.start + targetProgress * (st.end - st.start);
        window.scrollTo({ top: targetY, behavior: 'smooth' });
      }

      const prevBtn = whySec.querySelector('#whyMobilePrev');
      const nextBtn = whySec.querySelector('#whyMobileNext');
      if (prevBtn) prevBtn.addEventListener('click', () => goToWhySlide(currentWhySlide - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => goToWhySlide(currentWhySlide + 1));

      // Touch swipe handler for mobile screen
      const stickyBox = whySec.querySelector('#whyStickyContainer');
      if (stickyBox) {
        let touchStartX = 0,
          touchStartY = 0;
        stickyBox.addEventListener(
          'touchstart',
          (e) => {
            touchStartX = e.changedTouches[0].clientX;
            touchStartY = e.changedTouches[0].clientY;
          },
          { passive: true }
        );

        stickyBox.addEventListener(
          'touchend',
          (e) => {
            const diffX = e.changedTouches[0].clientX - touchStartX;
            const diffY = e.changedTouches[0].clientY - touchStartY;
            if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY) * 1.2) {
              if (diffX < 0) {
                goToWhySlide(currentWhySlide + 1);
              } else {
                goToWhySlide(currentWhySlide - 1);
              }
            }
          },
          { passive: true }
        );
      }

      // Refresh ScrollTrigger after layout settles
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 500);
      window.addEventListener('nidhi:loaderDone', () => {
        setTimeout(() => ScrollTrigger.refresh(), 300);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWhyNidhi);
    } else {
      initWhyNidhi();
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target && e.target.querySelector('#nidhiWhyTeaComponent')) {
        initWhyNidhi();
      }
    });
  })();
</script>

