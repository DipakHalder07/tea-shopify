{% comment %}
  Nidhi Why Tea Section - Arched Intro & Scroll-Scrubbed Pinned Orbital Slides
  Faithfully ported from Nidhi Tea index.html with GSAP ScrollTrigger
{% endcomment %}

<div class="nidhi-why-tea-component" id="nidhiWhyTeaComponent">
  <!-- ============ WHY NIDHI TEA (STANDALONE INTRO HEADING SECTION) ============ -->
  <section id="whyIntroSection" class="why-intro-section">
    <!-- Background Ambient Glow -->
    <div id="whyIntroGlow" class="why-intro-glow"></div>

    <!-- Ambient Botanical Tea Leaf Branch Silhouettes -->
    <img
      src="{{ 'botanical-tea-branch.svg' | asset_url }}"
      alt=""
      aria-hidden="true"
      class="why-branch why-branch-left"
    />
    <img
      src="{{ 'botanical-tea-branch.svg' | asset_url }}"
      alt=""
      aria-hidden="true"
      class="why-branch why-branch-right"
    />

    <!-- Top: Giant Curved Arched Heading & Subtitle (Full-Width Edge-to-Edge) -->
    <div class="why-intro-content">
      <!-- Giant Arched SVG Headline (Round style like old, with Hero Outline & Sized like Hero) -->
      <div class="why-arc-headline-box">
        <svg
          viewBox="0 0 1600 320"
          class="why-arc-svg"
          preserveAspectRatio="xMidYMid meet"
          aria-hidden="true"
        >
          <path id="whyArcPath" d="M 40,300 Q 800,-40 1560,300" fill="none" stroke="none"></path>
          <text class="why-arc-text">
            <textPath href="#whyArcPath" startOffset="50%" text-anchor="middle">
              {{ section.settings.heading | default: 'WHY NIDHI TEA' }}
            </textPath>
          </text>
        </svg>
      </div>

      <!-- Centered Subtitle Paragraph -->
      <p class="why-intro-subtitle">
        {{ section.settings.subtitle | default: "WE CRAFT SMALL-BATCH MOUNTAIN<br>TEAS BECAUSE MASS-PRODUCED<br>TEA TASTES LIKE DUST. WE'RE<br><strong class='why-highlight'>BREWING BETTER DAYS.</strong>" }}
      </p>
    </div>
  </section>

  <!-- ============ WHY NIDHI TEA (SCROLL-SCRUBBED PINNED SLIDES) ============ -->
  <section id="whySection" class="why-section">
    <div id="whyStickyContainer" class="why-sticky-container">
      <!-- Ambient Repeating Tea Leaf Pattern Background -->
      <div
        class="why-bg-pattern"
        style="background-image: url('{{ 'tea-leaf-pattern.svg' | asset_url }}');"
      ></div>

      <!-- Ambient Botanical Tea Leaf Branch Silhouettes in Background -->
      <img
        src="{{ 'botanical-tea-branch.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        class="why-branch why-branch-top-left"
      />
      <img
        src="{{ 'botanical-tea-branch.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        class="why-branch why-branch-bottom-right"
      />

      <!-- Arched Dotted Orbital Track Line (Curved across the screen passing through slides) -->
      <div class="why-line-wrapper">
        <svg
          viewBox="0 0 2400 900"
          class="why-track-svg"
          preserveAspectRatio="none"
        >
          <path id="whyArcLine" class="why-line" d="M -300, 780 Q 1200, 310 2700, 780" />
        </svg>
      </div>

      <!-- Center Slides Stack -->
      <div class="why-slides-stack">
        <!-- Slide 1 -->
        <div class="why-slide slide-1">
          <div class="why-num-wrapper">
            <span class="why-number">{{ section.settings.slide_1_number | default: '01' }}</span>
          </div>
          <div class="why-pill-wrapper">
            <div class="why-pill-badge">
              <span class="why-pill-dot"></span>
              <h3 class="why-pill-title">{{ section.settings.slide_1_title | default: 'ESTATE SOURCED' }}</h3>
              <span class="why-pill-dot"></span>
            </div>
            <img
              src="{{ section.settings.slide_1_image | default: 'isolated_rustic_clay_tea_pot_yixing_style_side_view_transparent_background.png' | asset_url }}"
              alt="{{ section.settings.slide_1_title | default: 'Estate Clay Teapot' }}"
              class="why-mascot"
              style="--float-duration: 7s;"
            />
          </div>
          <p class="why-desc-text">
            {{ section.settings.slide_1_desc | default: 'Direct partnerships with heritage tea gardens across Assam, Darjeeling and the Nilgiris. Pure whole leaves, harvested at peak freshness.' }}
          </p>
        </div>

        <!-- Slide 2 -->
        <div class="why-slide slide-2">
          <div class="why-num-wrapper">
            <span class="why-number">{{ section.settings.slide_2_number | default: '02' }}</span>
          </div>
          <div class="why-pill-wrapper">
            <div class="why-pill-badge">
              <span class="why-pill-dot"></span>
              <h3 class="why-pill-title">{{ section.settings.slide_2_title | default: '100% BOTANICALS' }}</h3>
              <span class="why-pill-dot"></span>
            </div>
            <img
              src="{{ section.settings.slide_2_image | default: 'isolated_cinnamon_sticks_star_anise_and_dried_orange_slices_for_tea_flavoring.png' | asset_url }}"
              alt="{{ section.settings.slide_2_title | default: 'Botanical Spices' }}"
              class="why-mascot"
              style="--float-duration: 8s;"
            />
          </div>
          <p class="why-desc-text">
            {{ section.settings.slide_2_desc | default: 'Fresh crushed mountain spices, sun-dried herbs and raw ginger roots. No powders, no artificial flavours, no synthetic additives.' }}
          </p>
        </div>

        <!-- Slide 3 -->
        <div class="why-slide slide-3">
          <div class="why-num-wrapper">
            <span class="why-number">{{ section.settings.slide_3_number | default: '03' }}</span>
          </div>
          <div class="why-pill-wrapper">
            <div class="why-pill-badge">
              <span class="why-pill-dot"></span>
              <h3 class="why-pill-title">{{ section.settings.slide_3_title | default: 'ARTISAN FRESH' }}</h3>
              <span class="why-pill-dot"></span>
            </div>
            <img
              src="{{ section.settings.slide_3_image | default: 'isolated_glass_teapot_filled_with_blooming_jasmine_tea_side_view_professional.png' | asset_url }}"
              alt="{{ section.settings.slide_3_title | default: 'Artisan Blooming Tea' }}"
              class="why-mascot"
              style="--float-duration: 7.5s;"
            />
          </div>
          <p class="why-desc-text">
            {{ section.settings.slide_3_desc | default: 'Slow-blended in small batches and vacuum-sealed to preserve natural essential oils for a fragrant, soothing cup every single time.' }}
          </p>
        </div>
      </div>

      <!-- Mobile Slider Left Arrow Button -->
      <button id="whyMobilePrev" class="why-mobile-btn why-mobile-prev" aria-label="Previous Slide">
        <svg class="why-btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Mobile Slider Right Arrow Button -->
      <button id="whyMobileNext" class="why-mobile-btn why-mobile-next" aria-label="Next Slide">
        <svg class="why-btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </section>
</div>

<style>
  .nidhi-why-tea-component {
    position: relative;
    width: 100%;
