<script>
  (function () {
    const sectionContainer = document.getElementById("nidhi-benefits-{{ section.id }}");
    if (!sectionContainer) return;

    /* ---------- INTRO TEXT (GSAP Letters Slide Up Reveal Animation) ---------- */
    function initIntroAnimation() {
      const p = sectionContainer.querySelector("#introText");
      if (!p || p.dataset.introInit === "true") return;
      p.dataset.introInit = "true";

      let originalText = p.textContent.trim().replace(/\s+/g, " ");
      if (!originalText) return;

      originalText = originalText
        .replace(/â˜\.\.\./g, "★")
        .replace(/â˜…/g, "★")
        .replace(/â€”/g, "—")
        .replace(/â€“/g, "–")
        .replace(/â€™/g, "’");

      const words = originalText.split(" ");
      p.innerHTML = words
        .map((w) => {
          const charsHtml = w
            .split("")
            .map((ch) => {
              const isStar = ch === "★" || ch === "✦";
              return `<span class="intro-char ${isStar ? "text-gold" : ""}">${ch}</span>`;
            })
            .join("");
          return `<span class="intro-word">${charsHtml}</span>`;
        })
        .join("");

      const chars = [...p.querySelectorAll(".intro-char")];

      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined") {
        chars.forEach((c) => {
          c.style.transform = "none";
          c.style.opacity = "1";
        });
        return;
      }

      gsap.registerPlugin(ScrollTrigger);

      // Set initial hidden state below baseline
      gsap.set(chars, { yPercent: 140, scale: 0.6, opacity: 0 });

      gsap.fromTo(
        chars,
        {
          yPercent: 140,
          scale: 0.6,
          opacity: 0,
        },
        {
          yPercent: 0,
          scale: 1,
          opacity: 1,
          duration: 0.55,
          stagger: 0.007,
          ease: "back.out(2.5)",
          scrollTrigger: {
            trigger: p,
            start: "top 82%",
            toggleActions: "restart none none reverse",
          },
        }
      );
    }

    /* ---------- FLOATING INGREDIENTS ELASTIC POP-UP ON SCROLL ---------- */
    function initFloatingIngredients() {
      const foodItems = sectionContainer.querySelectorAll(".floating-food-item");
      if (!foodItems.length) return;

      if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);
        foodItems.forEach((el, index) => {
          gsap.fromTo(
            el,
            { scale: 0, opacity: 0, rotate: -20 },
            {
              scale: 1,
              opacity: 1,
              rotate: 0,
              duration: 1.1,
              delay: index * 0.05,
              ease: "elastic.out(1, 0.4)",
              scrollTrigger: {
                trigger: sectionContainer.querySelector("#nidhiBenefitsSection") || sectionContainer,
                start: "top 85%",
                toggleActions: "play none none reverse",
              },
            }
          );
        });
      } else {
        foodItems.forEach((el) => {
          el.style.transform = "scale(1)";
          el.style.opacity = "1";
        });
      }
    }

    /* ---------- INTERACTIVE SMOOTH MOUSE PARALLAX ON FLOATING BOTANICALS ---------- */
    function initMouseParallax() {
      if (window.innerWidth < 768) return;

      const items = [
        { el: sectionContainer.querySelector(".item-tea-sprig"), fx: -26, fy: -30 },
        { el: sectionContainer.querySelector(".item-citrus"), fx: 24, fy: -26 },
        { el: sectionContainer.querySelector(".item-chamomile"), fx: -22, fy: 24 },
        { el: sectionContainer.querySelector(".item-cinnamon"), fx: 20, fy: 22 },
        { el: sectionContainer.querySelector(".item-teacup"), fx: -18, fy: -20 },
        { el: sectionContainer.querySelector(".item-cardamom"), fx: 22, fy: 26 },
        { el: sectionContainer.querySelector(".floating-sparkle-star"), fx: 14, fy: 16 },
      ].filter((item) => item.el);

      if (!items.length) return;

      let targetX = 0;
      let targetY = 0;
      let curX = 0;
      let curY = 0;
      let rafId = null;

      window.addEventListener("mousemove", (e) => {
        const w = window.innerWidth;
        const h = window.innerHeight;
        targetX = (e.clientX / w - 0.5) * 2;
        targetY = (e.clientY / h - 0.5) * 2;
        if (!rafId) {
          rafId = requestAnimationFrame(updateMouse);
        }
      }, { passive: true });

      function updateMouse() {
        const dx = targetX - curX;
        const dy = targetY - curY;
        if (Math.abs(dx) > 0.005 || Math.abs(dy) > 0.005) {
          curX += dx * 0.06;
          curY += dy * 0.06;
          items.forEach(({ el, fx, fy }) => {
            el.style.setProperty("--mouse-x", `${(curX * fx).toFixed(1)}px`);
            el.style.setProperty("--mouse-y", `${(curY * fy).toFixed(1)}px`);
          });
          rafId = requestAnimationFrame(updateMouse);
        } else {
          curX = targetX;
          curY = targetY;
          items.forEach(({ el, fx, fy }) => {
            el.style.setProperty("--mouse-x", `${(curX * fx).toFixed(1)}px`);
            el.style.setProperty("--mouse-y", `${(curY * fy).toFixed(1)}px`);
          });
          rafId = null;
        }
      }
    }

    /* ---------- BENEFITS STICKY STACK & SMOOTH HEADING DESIGN (SUBTLE TILT & ULTRA-SMOOTH LERP) ---------- */
    function initBenefitsStack() {
      const root = sectionContainer.querySelector("#benefits");
      if (!root) return;

      const wraps = [...root.querySelectorAll(".bene-wrap")];
      if (!wraps.length) return;

      const DOCKED_HEADER_COLORS = [
        "#faebd7", // front active card (warm creamy ivory)
        "#e5d7c3", // 1 behind (soft tan cream)
        "#d6c8b2", // 2 behind (warm sand beige)
        "#c4b49c"  // 3 behind (rich parchment taupe)
      ];

      function getMetrics() {
        const isSmall = window.innerWidth < 640;
        const firstHeader = root.querySelector(".bene-header");
        const headerH = firstHeader ? firstHeader.offsetHeight : (isSmall ? 56 : 72);
        const BASE = isSmall ? 40 : 48;
        const gap = isSmall ? 6 : 8;
        const naturalStep = headerH + gap;

        const vh = window.innerHeight;
        const bodyH = isSmall ? 380 : 460;
        const availableForHeaders = vh - BASE - bodyH - 24;
        let stackStep = naturalStep;
        if (availableForHeaders > 100 && naturalStep * (wraps.length - 1) > availableForHeaders) {
          stackStep = Math.max(isSmall ? 48 : 58, Math.floor(availableForHeaders / (wraps.length - 1)));
        }
        return { BASE, STACK_STEP: stackStep, isSmall };
      }

      // Smooth physics lerp state for each card
      const cardStates = wraps.map(() => ({
        curX: 0,
        curY: 0,
        curRot: 0,
        curOpacity: 1,
        targetX: 0,
        targetY: 0,
        targetRot: 0,
        targetOpacity: 1
      }));

      function computeTargets() {
        const { BASE, STACK_STEP, isSmall } = getMetrics();
        const vh = window.innerHeight;
        const vw = window.innerWidth;

        // Subtle, classy corner offsets and gentle, lower tilt (further from corner of window, lower tilt angle)
        const cornerX = isSmall
          ? Math.min(180, Math.round(vw * 0.32))
          : Math.min(520, Math.round(vw * 0.38));
        const cornerY = isSmall ? 150 : 240;
        const cornerRot = isSmall ? 2.0 : 3.0; // gentle, elegant, lower tilt angle
        const tiltRange = vh * 0.85;

        // Card 1 stays in the same place (standard centered position, no corner fly-in)
        // Subsequent cards fly in from alternating corners:
        // Card 2: right-bottom corner come and stack
        // Card 3: bottom-left corner come and stack
        // Card 4: right-bottom corner come and stack
        const keyframeEntries = [
          { x: 0, y: 0, rot: 0 },
          { x: cornerX, y: cornerY, rot: cornerRot },
          { x: -cornerX, y: cornerY, rot: -cornerRot },
          { x: cornerX, y: cornerY, rot: cornerRot }
        ];

        // 1. Set sticky top and z-index for each wrap
        wraps.forEach((w, i) => {
          w.style.top = (BASE + i * STACK_STEP) + "px";
          w.style.zIndex = (i + 1) * 10;
        });

        // 2. Identify highest docked card (with generous 8px tolerance for subpixel renderers)
        let highestDockedIndex = -1;
        wraps.forEach((w, i) => {
          const targetTop = BASE + i * STACK_STEP;
          const rect = w.getBoundingClientRect();
          if (rect.top <= targetTop + 8) {
            highestDockedIndex = i;
          }
        });

        // 3. Compute target values for each card
        wraps.forEach((w, i) => {
          const targetTop = BASE + i * STACK_STEP;
          const rect = w.getBoundingClientRect();
          const dist = rect.top - targetTop;
          const entry = keyframeEntries[i] || { x: 0, y: 0, rot: 0 };
          const st = cardStates[i];
          const header = w.querySelector(".bene-header");

          if (!st) return;

          // 1st card stays in the same place without flying in
          if (i === 0) {
            st.targetX = 0;
            st.targetY = 0;
            st.targetRot = 0;
            st.targetOpacity = 1;
            w.classList.add("is-docked");
          } else if (dist <= 8) {
            // Docking condition: <= 8px handles subpixel scrolling and guarantees Card 4 locks flush
            st.targetX = 0;
            st.targetY = 0;
            st.targetRot = 0;
            st.targetOpacity = 1;
            w.classList.add("is-docked");
          } else {
            w.classList.remove("is-docked");
            if (dist >= tiltRange) {
              st.targetX = entry.x;
              st.targetY = entry.y;
              st.targetRot = entry.rot;
              st.targetOpacity = 0.25;
            } else {
              // Ultra-smooth sine in-out easing for seamless docking
              const rawProgress = Math.max(0, Math.min(1, 1 - (dist / tiltRange)));
              const eased = 0.5 * (1 - Math.cos(rawProgress * Math.PI));

              st.targetX = entry.x * (1 - eased);
              st.targetY = entry.y * (1 - eased);
              st.targetRot = entry.rot * (1 - eased);
              st.targetOpacity = 0.25 + 0.75 * eased;
            }
          }

          // Header color based on depth in the docked stack
          if (header) {
            if (i > highestDockedIndex) {
              header.style.backgroundColor = DOCKED_HEADER_COLORS[0];
            } else {
              const stepsBehind = highestDockedIndex - i;
              const color = DOCKED_HEADER_COLORS[Math.min(stepsBehind, DOCKED_HEADER_COLORS.length - 1)];
              header.style.backgroundColor = color;
            }
          }
        });
      }

      // Physics lerp loop for silky 60fps/120fps motion
      let animId = null;
      function tick() {
        let needsUpdate = false;
        const lerpFactor = 0.13; // buttery soft damping factor

        wraps.forEach((w, i) => {
          const card = w.querySelector(".bene-card");
          const st = cardStates[i];
          if (!card || !st) return;

          const dx = st.targetX - st.curX;
          const dy = st.targetY - st.curY;
          const drot = st.targetRot - st.curRot;
          const dop = st.targetOpacity - st.curOpacity;

          if (Math.abs(dx) > 0.05 || Math.abs(dy) > 0.05 || Math.abs(drot) > 0.02 || Math.abs(dop) > 0.01) {
            st.curX += dx * lerpFactor;
            st.curY += dy * lerpFactor;
            st.curRot += drot * lerpFactor;
            st.curOpacity += dop * lerpFactor;
            needsUpdate = true;
          } else {
            st.curX = st.targetX;
            st.curY = st.targetY;
            st.curRot = st.targetRot;
            st.curOpacity = st.targetOpacity;
          }

          card.style.transform = `translate3d(${st.curX.toFixed(2)}px, ${st.curY.toFixed(2)}px, 0) rotate(${st.curRot.toFixed(2)}deg)`;
          card.style.opacity = st.curOpacity.toFixed(2);
        });

        if (needsUpdate) {
          animId = requestAnimationFrame(tick);
        } else {
          animId = null;
        }
      }

      function requestTick() {
        computeTargets();
        if (!animId) {
          animId = requestAnimationFrame(tick);
        }
      }

      // Initial immediate placement
      computeTargets();
      wraps.forEach((w, i) => {
        const card = w.querySelector(".bene-card");
        const st = cardStates[i];
        if (!card || !st) return;
        st.curX = st.targetX;
        st.curY = st.targetY;
        st.curRot = st.targetRot;
        st.curOpacity = st.targetOpacity;
        card.style.transform = `translate3d(${st.curX.toFixed(2)}px, ${st.curY.toFixed(2)}px, 0) rotate(${st.curRot.toFixed(2)}deg)`;
        card.style.opacity = st.curOpacity.toFixed(2);
      });

      window.addEventListener("scroll", requestTick, { passive: true });
      if (window.lenis) {
        window.lenis.on("scroll", requestTick);
      } else {
        window.addEventListener("lenis:ready", () => {
          if (window.lenis) window.lenis.on("scroll", requestTick);
        });
      }
      window.addEventListener("resize", () => { computeTargets(); requestTick(); }, { passive: true });
      window.addEventListener("load", () => { computeTargets(); requestTick(); });
      window.addEventListener("nidhi:loaderDone", () => { computeTargets(); requestTick(); });
      setTimeout(requestTick, 200);
      setTimeout(requestTick, 600);
      setTimeout(requestTick, 1200);
    }

    // Initialize scripts once DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initIntroAnimation();
        initFloatingIngredients();
        initMouseParallax();
        initBenefitsStack();
      });
    } else {
      initIntroAnimation();
      initFloatingIngredients();
      initMouseParallax();
      initBenefitsStack();
    }

    // Also support Shopify Theme Customizer events
    document.addEventListener("shopify:section:load", (e) => {
      if (e.target && e.target.contains(sectionContainer)) {
        initIntroAnimation();
        initFloatingIngredients();
        initMouseParallax();
        initBenefitsStack();
      }
    });
  })();
</script>

