{% comment %}
  Nidhi Tea Benefits Scroll & Intro Section
  Faithfully ports the ScrollTrigger sticky-stacked benefits cards, intro text reveal,
  and floating ambient ingredients from Nidhi Tea index.html
{% endcomment %}

<div class="nidhi-benefits-container" id="nidhi-benefits-{{ section.id }}" data-section-id="{{ section.id }}">
  <!-- ============ INTRO HEADLINE SECTION ============ -->
  <section class="nidhi-intro-section" id="nidhiIntro">
    <div class="nidhi-intro-inner">
      <p id="introText" class="nidhi-intro-text">
        {{ section.settings.intro_text | default: "Premium handcrafted teas sourced from the finest estates. ★ No artificial additives — just pure leaves, pure water, and a moment of peace in every single cup." | replace: 'â˜…', '★' | replace: 'â€”', '—' | replace: 'â˜...', '★' | replace: 'â€“', '–' | replace: 'â€™', '’' }}
      </p>
    </div>
  </section>

  <!-- ============ BENEFITS STICKY STACK SECTION ============ -->
  <section class="nidhi-benefits-stack-section" id="nidhiBenefitsSection">
    <div class="nidhi-benefits-backdrop-gradient" aria-hidden="true"></div>

    {% if section.settings.show_floating_elements %}
      <!-- Ambient Floating Food / Botanical Elements (Behind Cards, z-index: 5) -->
      <div class="nidhi-benefits-fixed-bg-wrapper" aria-hidden="true">
        <div class="nidhi-floating-food pointer-events-none">
          <!-- 6 Botanical Floating Elements matching user reference -->
          <div class="floating-food-item item-chamomile" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_chamomile_anise.png' | asset_url }}" alt="Dried chamomile flowers and star anise" loading="lazy" class="float-item-chamomile" />
            </div>
          </div>
          <div class="floating-food-item item-cinnamon" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_cinnamon_tea.png' | asset_url }}" alt="Cinnamon sticks bundle and loose black tea" loading="lazy" class="float-item-cinnamon" />
            </div>
          </div>
          <div class="floating-food-item item-teacup" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_glass_teacup.webp' | asset_url }}" alt="Steaming amber tea in glass cup" loading="lazy" class="float-item-teacup" />
            </div>
          </div>
          <div class="floating-food-item item-tea-sprig" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_green_tea_sprig.png' | asset_url }}" alt="Fresh green tea leaves sprig" loading="lazy" class="float-item-sprig" />
            </div>
          </div>
          <div class="floating-food-item item-citrus" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_dried_citrus.png' | asset_url }}" alt="Dried citrus slices and lemon wheel" loading="lazy" class="float-item-citrus" />
            </div>
          </div>
          <div class="floating-food-item item-cardamom" style="transform: scale(0); opacity: 0;">
            <div class="food-drift-wrap">
              <img src="{{ 'nidhi_element_cardamom_cloves.png' | asset_url }}" alt="Green cardamom pods and whole cloves" loading="lazy" class="float-item-cardamom" />
            </div>
          </div>
          <div class="floating-sparkle-star" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M12 0 C12 6.627 17.373 12 24 12 C17.373 12 12 17.373 12 24 C12 17.373 6.627 12 0 12 C6.627 12 12 6.627 12 0 Z"/>
            </svg>
          </div>
        </div>
      </div>
    {% endif %}

    <!-- Centered Stack Container -->
    <div id="benefits" class="nidhi-benefits-cards-wrap">
      {% comment %} Card 1: WHOLE LEAF ASSAM {% endcomment %}
      <div class="bene-wrap" style="z-index: 1;">
        <div class="bene-card">
          <div class="bene-header">
            <span class="bene-header-star">•</span>
            <h3 class="bene-header-title">WHOLE LEAF ASSAM</h3>
            <span class="bene-header-star">•</span>
          </div>
          <div class="bene-body">
            <span class="bene-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="bene-svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 38V23"></path>
                <path d="M24 8C20.5 13.5 21.5 20.5 24 24C26.5 20.5 27.5 13.5 24 8Z"></path>
                <path d="M24 11V23"></path>
                <path d="M23 28C16 26.5 12.5 19.5 14 13C19 13.5 23 18.5 23.5 25"></path>
                <path d="M15.5 17C18.5 19.5 21 22.5 22.5 26"></path>
                <path d="M25 28C32 26.5 35.5 19.5 34 13C29 13.5 25 18.5 24.5 25"></path>
                <path d="M32.5 17C29.5 19.5 27 22.5 25.5 26"></path>
              </svg>
            </span>
            <p class="bene-text">Handcrafted orthodox whole leaves from the misty estates of Upper Assam. Rich, malty, and brisk with deep amber liquor in every steep.</p>
            <div class="bene-dim"></div>
          </div>
        </div>
      </div>

      {% comment %} Card 2: ZERO ARTIFICIAL FLAVORS {% endcomment %}
      <div class="bene-wrap" style="z-index: 2;">
        <div class="bene-card">
          <div class="bene-header">
            <span class="bene-header-star">•</span>
            <h3 class="bene-header-title">ZERO ARTIFICIAL FLAVORS</h3>
            <span class="bene-header-star">•</span>
          </div>
          <div class="bene-body">
            <span class="bene-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="bene-svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 38V23"></path>
                <path d="M24 8C20.5 13.5 21.5 20.5 24 24C26.5 20.5 27.5 13.5 24 8Z"></path>
                <path d="M24 11V23"></path>
                <path d="M23 28C16 26.5 12.5 19.5 14 13C19 13.5 23 18.5 23.5 25"></path>
                <path d="M15.5 17C18.5 19.5 21 22.5 22.5 26"></path>
                <path d="M25 28C32 26.5 35.5 19.5 34 13C29 13.5 25 18.5 24.5 25"></path>
                <path d="M32.5 17C29.5 19.5 27 22.5 25.5 26"></path>
              </svg>
            </span>
            <p class="bene-text">No artificial flavours. No synthetic colours. Every blend is made with leaves, herbs, and botanicals exactly as nature intended — nothing more, nothing less.</p>
            <div class="bene-dim"></div>
          </div>
        </div>
      </div>

      {% comment %} Card 3: ETHICALLY SOURCED {% endcomment %}
      <div class="bene-wrap" style="z-index: 3;">
        <div class="bene-card">
          <div class="bene-header">
            <span class="bene-header-star">•</span>
            <h3 class="bene-header-title">ETHICALLY SOURCED</h3>
            <span class="bene-header-star">•</span>
          </div>
          <div class="bene-body">
            <span class="bene-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="bene-svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 38V23"></path>
                <path d="M24 8C20.5 13.5 21.5 20.5 24 24C26.5 20.5 27.5 13.5 24 8Z"></path>
                <path d="M24 11V23"></path>
                <path d="M23 28C16 26.5 12.5 19.5 14 13C19 13.5 23 18.5 23.5 25"></path>
                <path d="M15.5 17C18.5 19.5 21 22.5 22.5 26"></path>
                <path d="M25 28C32 26.5 35.5 19.5 34 13C29 13.5 25 18.5 24.5 25"></path>
                <path d="M32.5 17C29.5 19.5 27 22.5 25.5 26"></path>
              </svg>
            </span>
            <p class="bene-text">We partner directly with small-estate farmers across Darjeeling, Assam, and the Nilgiris. Fresh harvests, fair wages, and full traceability from garden to cup.</p>
            <div class="bene-dim"></div>
          </div>
        </div>
      </div>

      {% comment %} Card 4: SINGLE-ESTATE MATCHA {% endcomment %}
      <div class="bene-wrap" style="z-index: 4;">
        <div class="bene-card">
          <div class="bene-header">
            <span class="bene-header-star">•</span>
            <h3 class="bene-header-title">SINGLE-ESTATE MATCHA</h3>
            <span class="bene-header-star">•</span>
          </div>
          <div class="bene-body">
            <span class="bene-icon-badge">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="bene-svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M24 38V23"></path>
                <path d="M24 8C20.5 13.5 21.5 20.5 24 24C26.5 20.5 27.5 13.5 24 8Z"></path>
                <path d="M24 11V23"></path>
                <path d="M23 28C16 26.5 12.5 19.5 14 13C19 13.5 23 18.5 23.5 25"></path>
                <path d="M15.5 17C18.5 19.5 21 22.5 22.5 26"></path>
                <path d="M25 28C32 26.5 35.5 19.5 34 13C29 13.5 25 18.5 24.5 25"></path>
                <path d="M32.5 17C29.5 19.5 27 22.5 25.5 26"></path>
              </svg>
            </span>
            <p class="bene-text">Pure hand-plucked matcha from the Uji region. Sifted for smoothness, not bulk. The finest quality, straight to your cup.</p>
            <div class="bene-dim"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- End Icon After Wellness First Card -->
    {% if section.settings.show_end_icon %}
      <div id="benefitsEndIcon" class="nidhi-benefits-end-icon" aria-hidden="true">
        <div class="nidhi-flourish-wrap">
          <svg width="132" height="55" viewBox="0 0 132 55" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="End Flourish Icon">
            <path d="M130.646 52.5133C115.515 53.6813 101.169 49.7666 88.1777 42.1967C76.5616 35.4271 66.4302 26.5595 55.8185 18.4057C45.2068 10.2519 33.3286 1.77363 19.8347 0.151521C11.996 -0.800119 -1.51973 2.63876 0.139715 13.0852C1.03494 18.7301 7.47621 20.5901 12.3672 21.412C20.2933 22.753 28.8307 22.1906 36.5602 20.136C38.5035 19.6169 37.9358 17.4757 35.9707 17.9948C29.2892 19.7683 22.04 20.2657 15.1839 19.4006C10.8606 18.8599 4.332 17.6487 3.37127 12.5661C2.65072 8.82442 5.18356 5.36391 8.43695 3.72017C14.376 0.735482 21.8872 2.53062 27.7608 4.71507C39.0275 8.93256 48.744 16.4592 58.0675 23.8344C67.391 31.2096 77.2603 39.3634 88.0904 45.3112C101.126 52.4701 115.449 55.9306 130.363 54.7843C132.131 54.6545 132.808 52.3403 130.646 52.4917V52.5133Z" fill="currentColor"></path>
            <path d="M1.35355 52.5133C16.4851 53.6813 30.8306 49.7666 43.8223 42.1967C55.4384 35.4271 65.5698 26.5595 76.1815 18.4057C86.7932 10.2519 98.6714 1.77363 112.165 0.151521C120.004 -0.800119 133.52 2.63876 131.86 13.0852C130.965 18.7301 124.524 20.5901 119.633 21.412C111.707 22.753 103.169 22.1906 95.4398 20.136C93.4965 19.6169 94.0642 17.4757 96.0293 17.9948C102.711 19.7683 109.96 20.2657 116.816 19.4006C121.139 18.8599 127.668 17.6487 128.629 12.5661C129.349 8.82442 126.816 5.36391 123.563 3.72017C117.624 0.735482 110.113 2.53062 104.239 4.71507C92.9725 8.93256 83.256 16.4592 73.9325 23.8344C64.609 31.2096 54.7397 39.3634 43.9096 45.3112C30.8742 52.4701 16.5506 55.9306 1.63741 54.7843C-0.13121 54.6545 -0.80809 52.3403 1.35355 52.4917V52.5133Z" fill="currentColor"></path>
          </svg>
        </div>
      </div>
    {% endif %}
  </section>
</div>

<style>
  /* ================= NIDHI BENEFITS SECTION STYLES ================= */
  .nidhi-benefits-container {
    position: relative;
    background-color: transparent;
    color: #f5e4c7;
    overflow-x: clip;
    overflow-y: visible;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* ============ INTRO SECTION ============ */
  .nidhi-intro-section {
    position: relative;
    z-index: 10;
    padding: 3.5rem 1.5rem 2.5rem 1.5rem;
    overflow: hidden;
    text-align: center;
  }
  @media (min-width: 640px) {
    .nidhi-intro-section {
      padding: 5rem 2rem 4rem 2rem;
    }
  }
  @media (min-width: 768px) {
    .nidhi-intro-section {
      padding: 7rem 2.5rem 6rem 2.5rem;
    }
  }

  .nidhi-intro-inner {
    max-width: 72rem; /* 1152px */
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .nidhi-intro-text {
    font-family: var(--font-display-family, "Fraunces", Georgia, serif) !important;
    font-size: clamp(2.35rem, 5.8vw, 4.35rem) !important;
    line-height: 1.22 !important;
    font-weight: 700 !important;
    color: #f5e4c7 !important;
    margin: 0 auto !important;
    text-align: center !important;
    letter-spacing: -0.015em;
  }

  /* Split text styles */
  .nidhi-intro-text .intro-word {
    display: inline-block;
    white-space: nowrap;
    vertical-align: top;
    overflow: hidden;
    padding-top: 0.28em;
    margin-top: -0.28em;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
    margin-right: 0.28em;
  }

  .nidhi-intro-text .intro-char {
    display: inline-block;
    will-change: transform, opacity;
    transform-origin: 50% 100%;
    color: #f5e4c7;
  }

  .nidhi-intro-text .intro-char.text-gold {
    color: #f7c665 !important;
    display: inline-block;
    margin: 0 0.18em;
    transform: scale(1.15) translateY(-0.06em);
  }

  /* ============ BENEFITS STACK SECTION ============ */
  .nidhi-benefits-stack-section {
    position: relative;
    padding-bottom: 2.5rem;
    overflow: visible; /* CRITICAL: overflow must be visible for position: sticky to work! */
  }
  @media (min-width: 768px) {
    .nidhi-benefits-stack-section {
      padding-bottom: 3.5rem;
    }
  }

  /* Fixed Ambient Floating Food Backdrop - Stays FIXED in viewport while cards scroll */
  .nidhi-benefits-backdrop-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(30, 20, 13, 0.45) 0%, rgba(16, 11, 6, 0.85) 70%, #100b06 100%);
  }

  .nidhi-benefits-fixed-bg-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: clip;
    z-index: 5;
  }

  .nidhi-floating-food {
    pointer-events: none;
    position: -webkit-sticky;
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: transparent;
  }

  .floating-food-item {
    position: absolute;
    will-change: transform, opacity;
    pointer-events: none;
    user-select: none;
  }

  .food-drift-wrap {
    width: 100%;
    height: 100%;
    transform: translate3d(var(--mouse-x, 0px), var(--mouse-y, 0px), 0);
    will-change: transform;
    pointer-events: none;
  }

  /* Positioning of 6 Botanical Floating Items + Sparkle Star */
  .floating-food-item.item-chamomile {
    left: 6%;
    top: 5%;
    width: clamp(160px, 18vw, 270px);
  }
  .floating-food-item.item-cinnamon {
    left: 14%;
    top: 36%;
    width: clamp(210px, 23vw, 340px);
  }
  .floating-food-item.item-teacup {
    left: 3%;
    bottom: 6%;
    width: clamp(150px, 16vw, 245px);
  }
  .floating-food-item.item-tea-sprig {
    right: 17%;
    top: 5%;
    width: clamp(165px, 18.5vw, 275px);
  }
  .floating-food-item.item-citrus {
    right: 5%;
    top: 25%;
    width: clamp(155px, 17vw, 260px);
  }
  .floating-food-item.item-cardamom {
    right: 14%;
    bottom: 7%;
    width: clamp(160px, 18vw, 265px);
  }

  .floating-sparkle-star {
    position: absolute;
    right: 6%;
    bottom: 13%;
    width: 32px;
    height: 32px;
    color: rgba(245, 228, 199, 0.35);
    pointer-events: none;
    user-select: none;
    animation: sparkle-float 5s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes sparkle-float {
    0% {
      opacity: 0.22;
      transform: translate3d(0, 0, 0) rotate(0deg) scale(0.95);
    }
    35% {
      opacity: 0.7;
      transform: translate3d(-6px, -10px, 0) rotate(20deg) scale(1.15);
    }
    70% {
      opacity: 0.4;
      transform: translate3d(6px, -6px, 0) rotate(-10deg) scale(1.02);
    }
    100% {
      opacity: 0.22;
      transform: translate3d(0, 0, 0) rotate(0deg) scale(0.95);
    }
  }

  @media (max-width: 1400px) {
    .floating-food-item.item-chamomile { left: 4%; width: clamp(140px, 16vw, 220px); }
    .floating-food-item.item-cinnamon { left: 11%; width: clamp(185px, 21vw, 300px); }
    .floating-food-item.item-teacup { left: 2%; width: clamp(130px, 14.5vw, 200px); }
    .floating-food-item.item-tea-sprig { right: 14%; width: clamp(150px, 17vw, 240px); }
    .floating-food-item.item-citrus { right: 3.5%; width: clamp(135px, 15vw, 215px); }
    .floating-food-item.item-cardamom { right: 9%; width: clamp(140px, 16vw, 220px); }
    .floating-sparkle-star { right: 3%; }
  }

  @media (max-width: 1024px) {
    .floating-food-item.item-chamomile { left: 2%; top: 3%; width: clamp(100px, 12vw, 150px); }
    .floating-food-item.item-cinnamon { left: 4%; top: 37%; width: clamp(130px, 15vw, 185px); }
    .floating-food-item.item-teacup { left: 2%; bottom: 3%; width: clamp(95px, 11vw, 140px); }
    .floating-food-item.item-tea-sprig { right: 2%; top: 3%; width: clamp(110px, 13vw, 160px); }
    .floating-food-item.item-citrus { right: 2%; top: 32%; width: clamp(95px, 11vw, 140px); }
    .floating-food-item.item-cardamom { right: 2%; bottom: 3%; width: clamp(100px, 12vw, 150px); }
    .floating-sparkle-star { display: none; }
  }

  @media (max-width: 640px) {
    .floating-food-item {
      opacity: 0.32 !important;
    }
  }

  .floating-food-item img {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.7));
    will-change: transform;
    transform-origin: 50% 50%;
  }

  /* Ultra-smooth continuous closed-loop floating animations */

  /* 1. Green Tea Sprig - Seamless organic breeze wave */
  .float-item-sprig {
    animation: sprig-float 8.5s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes sprig-float {
    0% {
      transform: translate3d(0, 0, 0) rotate(6deg) scale(1);
    }
    25% {
      transform: translate3d(-18px, -24px, 0) rotate(12deg) scale(1.02);
    }
    50% {
      transform: translate3d(12px, -38px, 0) rotate(3deg) scale(0.98);
    }
    75% {
      transform: translate3d(16px, -16px, 0) rotate(-2deg) scale(1.01);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(6deg) scale(1);
    }
  }

  /* 2. Dried Citrus - Seamless buoyant bobbing & drift */
  .float-item-citrus {
    animation: citrus-float 8.2s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes citrus-float {
    0% {
      transform: translate3d(0, 0, 0) rotate(-5deg) scale(1);
    }
    25% {
      transform: translate3d(-20px, -26px, 0) rotate(6deg) scale(1.03);
    }
    50% {
      transform: translate3d(10px, -36px, 0) rotate(-10deg) scale(0.97);
    }
    75% {
      transform: translate3d(15px, -14px, 0) rotate(2deg) scale(1.01);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(-5deg) scale(1);
    }
  }

  /* 3. Chamomile & Star Anise - Seamless fluid drift */
  .float-item-chamomile {
    animation: chamomile-float 9s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes chamomile-float {
    0% {
      transform: translate3d(0, 0, 0) rotate(-6deg);
    }
    25% {
      transform: translate3d(16px, -22px, 0) rotate(-12deg);
    }
    50% {
      transform: translate3d(-10px, -36px, 0) rotate(2deg);
    }
    75% {
      transform: translate3d(-14px, -15px, 0) rotate(5deg);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(-6deg);
    }
  }

  /* 4. Cinnamon Bundle & Tea - Seamless rolling buoyant drift */
  .float-item-cinnamon {
    animation: cinnamon-float 9.4s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes cinnamon-float {
    0% {
      transform: translate3d(0, 0, 0) rotate(4deg);
    }
    25% {
      transform: translate3d(14px, -20px, 0) rotate(10deg);
    }
    50% {
      transform: translate3d(-8px, -32px, 0) rotate(0deg);
    }
    75% {
      transform: translate3d(-12px, -12px, 0) rotate(-4deg);
    }
    100% {
      transform: translate3d(0, 0, 0) rotate(4deg);
    }
  }

  /* 5. Glass Teacup - Seamless smooth levitation wave */
  .float-item-teacup {
    animation: teacup-float 9.2s cubic-bezier(0.445, 0.05, 0.55, 0.95) infinite;
  }
  @keyframes teacup-float {
    0% {
      transform: translate3d(0, 0, 0) rotate(-3deg);
    }
    25% {
